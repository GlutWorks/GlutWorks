REGISTRY = OUT / "registry.json"
WATCHED = ["helix", GAMEMODE, "harness/addon"]  # a change under these makes a cached registry stale


def newest_source():
    """Latest modification time of any file or directory the registry is built from; a
    directory's time changes when a file in it is added, removed or renamed."""
    newest = 0.0
    for name in WATCHED:
        for root, dirs, files in os.walk(REPO / name):
            for entry in [root] + [os.path.join(root, f) for f in files]:
                try:
                    newest = max(newest, os.stat(entry).st_mtime)
                except OSError:
                    pass
    return newest


def registry_current(addons_mounted):
    """The cached registry when it was built at HEAD, with the same Workshop setting, from a
    tree nothing under WATCHED has changed in since the boot started; otherwise None."""
    try:
        registry = json.loads(REGISTRY.read_text())
        meta = registry["meta"]
    except (OSError, ValueError, KeyError):
        return None
    if meta.get("commit") != git("rev-parse", "HEAD") or meta.get("addons") != addons_mounted:
        return None
    if newest_source() >= meta.get("started", 0):
        return None
    return registry


def source_index():
    """Repository files item, recipe and station definitions can come from, by uniqueID.

    Mirrors Helix: items/sh_x.lua is item x, items/<base>/sh_x.lua is item x on base_<base>,
    items/base/sh_x.lua is base_x; ixcraft loads recipes/sh_x.lua and stations/sh_x.lua.
    """
    index = {"items": {}, "recipes": {}, "stations": {}, "entities": {}}
    for top in MOUNT:
        for path in sorted((REPO / top).rglob("sh_*.lua")):
            relative, uid = str(path.relative_to(REPO)), path.stem[3:]
            parent, grand = path.parent.name, path.parent.parent.name
            if parent == "items" or grand == "items":
                key = f"base_{uid}" if (grand == "items" and parent == "base") else uid
                index["items"].setdefault(key, []).append(relative)
            elif parent in ("recipes", "stations"):
                index[parent].setdefault(uid, []).append(relative)
        # Scripted classes, as Helix's LoadEntities names them: entities/<kind>/<name>.lua or
        # entities/<kind>/<name>/, with a realm prefix (sh_, sv_, cl_) dropped.
        for kind in ("entities", "weapons"):
            for path in sorted((REPO / top).rglob(f"entities/{kind}/*")):
                if path.is_dir() or path.suffix == ".lua":
                    name = re.sub(r"^(sh|sv|cl)_", "", path.stem if path.is_file() else path.name)
                    index["entities"].setdefault(name, []).append(str(path.relative_to(REPO)))
    return index


def pick_source(candidates, folder):
    """The candidate under the owning plugin's folder, else the gamemode's (it loads after
    Helix and wins), else the first one."""
    for prefix in ([folder + "/"] if folder else []) + [GAMEMODE + "/"]:
        for path in candidates:
            if path.startswith(prefix):
                return path
    return candidates[0] if candidates else None


def enrich_registry(registry, started, addons_mounted):
    """Adds source files, the recipes each item takes part in, and build metadata."""
    index = source_index()
    plugins = registry.get("plugins", {})

    def folder_of(plugin_id):
        return (plugins.get(plugin_id) or {}).get("folder")

    for plugin_id, plugin in plugins.items():
        folder = plugin.get("folder") or ""
        for candidate in (f"{folder}/sh_plugin.lua", f"{folder}/sh_schema.lua", folder):
            if folder and (REPO / candidate).is_file():
                plugin["file"] = candidate
                break
    for section, owner in (("items", None), ("recipes", "ixcraft"), ("stations", "ixcraft")):
        for uid, entry in registry.get(section, {}).items():
            candidates = index[section].get(uid, [])
            entry["file"] = pick_source(candidates, folder_of(entry.get("plugin") or owner))
            if len(candidates) > 1:
                entry["files"] = candidates

    # The game reports every scripted class; keep the checkout's own.
    entities = {}
    for cls, entry in registry.get("entities", {}).items():
        candidates = index["entities"].get(cls, [])
        if candidates or entry.get("source"):
            path = pick_source(candidates, None) or entry["source"]
            if (REPO / path).is_dir():  # a folder entity: name the file its functions come from
                inside = [entry.get("source") or ""] + [f"{path}/{name}" for name in ("shared.lua", "init.lua", "cl_init.lua")]
                path = next((f for f in inside if f.startswith(path + "/") and (REPO / f).is_file()), path)
            entry["file"] = path
            entities[cls] = entry
    registry["entities"] = entities

    items = registry.get("items", {})
    for entry in items.values():
        entry["recipes"] = {"requiredBy": [], "toolIn": [], "producedBy": []}
    for rid, recipe in sorted(registry.get("recipes", {}).items()):
        uses = {"requiredBy": list(recipe.get("requirements") or {}) + list(recipe.get("interchangeable_req") or {}),
                "toolIn": list(recipe.get("tools") or []),  # a list of uniqueIDs; ixcraft reads it with ipairs
                "producedBy": list(recipe.get("results") or {})}
        for role, ids in uses.items():
            for uid in ids:
                if uid in items and rid not in items[uid]["recipes"][role]:
                    items[uid]["recipes"][role].append(rid)

    registry["meta"].update({
        "commit": git("rev-parse", "HEAD"),
        "dirty": bool(git("status", "--porcelain", "--", *WATCHED, check=False)),
        "built": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "started": started,
        "addons": addons_mounted,
    })
    return registry


def decode_lua_text(raw):
    """Decodes text the game wrote. Lua strings are bytes, and some definitions (the cp1252
    book items) are not UTF-8, so any byte that is not valid UTF-8 is read as cp1252."""
    return raw.decode("utf-8", errors="gw-cp1252")


codecs.register_error("gw-cp1252", lambda err: (err.object[err.start:err.end].decode("cp1252", errors="replace"), err.end))


def build_registry(args, with_addons):
    """Boots the server in its own `dump` layer and writes the enriched registry."""
    need_install()
    if not with_addons:
        os.environ["GW_NO_ADDONS"] = "1"
    say(f"booting {REPO} to dump the registry ({'with' if with_addons else 'without'} Workshop content)", sys.stderr)
    started = time.time()
    result = run_headless(REPO, "dump", args.map, args.timeout, mode="dump")
    raw = RUN / "dump/data/registry.json"
    try:
        registry = json.loads(decode_lua_text(raw.read_bytes()))
    except (OSError, ValueError):
        for block in result.get("console_errors", [])[:10]:
            say(block, sys.stderr)
        die(f"the server did not write a registry ({'timed out' if result.get('timed_out') else 'see the errors above'}); "
            f"console log in {RUN / 'dump/upper/garrysmod/console.log'}", 1)
    for error in registry.get("meta", {}).get("errors", []):
        say(f"section failed in the game: {error}", sys.stderr)
    for error in result.get("errors", [])[:5]:
        say(f"lua error during the boot: {error.get('error')}", sys.stderr)
    OUT.mkdir(parents=True, exist_ok=True)
    REGISTRY.write_text(json.dumps(enrich_registry(registry, started, with_addons), indent=1, sort_keys=True))
    say(f"registry built in {result['seconds']}s", sys.stderr)
    return registry


def cmd_dump(args):
    """Builds or reuses .gw/registry.json and looks things up in it.

    Status goes to stderr so `gw dump items x | jq` sees only the entry.
    """
    with_addons = bool(args.addons and not os.environ.get("GW_NO_ADDONS"))
    registry = None if args.fresh else registry_current(with_addons)
    if registry:
        say(f"reusing {REGISTRY} (built {registry['meta']['built']} at this commit; --fresh rebuilds)", sys.stderr)
    else:
        registry = build_registry(args, with_addons)
    sections = sorted(name for name in registry if name != "meta")
    if not args.section:
        print(REGISTRY)
        for name in sections:
            print(f"  {name:10} {len(registry[name])}")
        return 0
    if args.section not in registry or args.section == "meta":
        die(f"no section {args.section}; sections are {', '.join(sections)}", 1)
    section = registry[args.section]
    if not args.id:
        print("\n".join(sorted(section)))
        return 0
    if args.id in section:
        print(json.dumps(section[args.id], indent=2, sort_keys=True))
        return 0
    close = difflib.get_close_matches(args.id, list(section), n=6, cutoff=0.5)
    close += [key for key in sorted(section) if args.id.lower() in key.lower() and key not in close][: 6 - len(close)]
    die(f"no {args.id} in {args.section}" + (f"; close: {', '.join(close)}" if close else ""), 1)


