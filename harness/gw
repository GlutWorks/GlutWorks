            or Path.home() / ".local/share/gw-harness")
DS = HOME / "gmodds"
STEAMCMD = HOME / "steamcmd"
TOOLS = HOME / "tools"
ADDONS = HOME / "addons"
RUN_ID = f"{REPO.name}-{hashlib.sha1(str(REPO).encode()).hexdigest()[:8]}"
RUN = HOME / "runs" / RUN_ID
OUT = Path(os.environ.get("T3CODE_OUTPUT_PATH") or os.environ.get("GW_OUT") or REPO / ".gw")
SLOT = os.environ.get("T3CODE_SLOT", "").strip()
JSON_MODE = False  # set by the verbs whose standard output is one JSON document

GAMEMODE = "ixhl2rp"
# Gamemode folders taken from the checkout. base/sandbox/terrortown in the repo are a 2022
# copy of the stock gamemodes; the server's own current copies are used unless GW_MOUNT=all.
