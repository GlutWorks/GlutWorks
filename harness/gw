STOCK = ["base", "sandbox", "terrortown"]

# glualint (FPtje/GLuaFixer) parses Garry's Mod Lua (`!=`, `&&`, `continue`, `//`), which
# plain luajit cannot. Pinned so every machine reports the same findings.
GLUALINT_VERSION = "1.30.0"
GLUALINT_URL = (f"https://github.com/FPtje/GLuaFixer/releases/download/{GLUALINT_VERSION}/"
                f"glualint-{GLUALINT_VERSION}-x86_64-linux.zip")
GLUALINT_SHA256 = "ddceb69c949a8a09d320b4f810e1baae1b46f0efa77aa31ca326a14dc4f6193a"
GLUALINT = TOOLS / "glualint" / GLUALINT_VERSION / "glualint"
LINTED = ["ixhl2rp", "harness"]  # helix/ is vendored upstream code: linted only when named

ERROR_LINE = re.compile(
    r"\[ERROR\]|Lua Error|Couldn't include file|error loading module|"
    r"Warning! A net message|Tried to use a NULL|\[gw_harness\]"
)


def say(msg, stream=None):
    print(f"[gw] {msg}", file=stream or (sys.stderr if JSON_MODE else sys.stdout), flush=True)


def die(msg, code=2, **detail):
    """Exits with `code`. A JSON verb also prints {"ok": false, "error": msg, ...detail}."""
    print(f"[gw] error: {msg}", file=sys.stderr)
    if JSON_MODE:
        print(json.dumps({"ok": False, "error": msg, **detail}, indent=1))
    sys.exit(code)


def emit(document):
    print(json.dumps(document, indent=1, ensure_ascii=False))


def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def read_text(path):
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return ""


def rmtree(path):
    """Removes a tree, including the mode-000 work directory overlayfs leaves behind."""
    if Path(path).exists():
        subprocess.run(["chmod", "-R", "u+rwX", str(path)], check=False)
        shutil.rmtree(path)


# --------------------------------------------------------------------------- sandbox


def addons():
    """Workshop addons the gamemode needs, as (id, directory) pairs in manifest order.

    harness/addons.json is the manifest; `gw setup` downloads and unpacks each one. Only
    entries marked required are mounted, so a run sees the same content every time
    regardless of what the Steam account happens to be subscribed to.
    """
    if os.environ.get("GW_NO_ADDONS"):
        return []
    try:
        manifest = json.loads((REPO / "harness/addons.json").read_text())
    except (OSError, ValueError):
        return []
    return [(entry["id"], ADDONS / entry["id"]) for entry in manifest if entry.get("required")]


def sandbox(src, layer, data, play=None, net=False):
    """bwrap argv giving the process a private root with the server install at /gw/ds.

    The install is the read-only lower layer of an overlay whose upper layer is under
    `layer`; the gamemodes from `src` and the harness addon are bound on top read-only,
    and `data` (a host directory) becomes the server's data/gw_harness. `play` adds what a
    graphical session needs: the GPU, the tools prefix, an output directory and, when the
    game client is installed, a second overlay for it at /gw/client.
    """
    upper, work = layer / "upper", layer / "work"
    for path in (upper, work, data):
        path.mkdir(parents=True, exist_ok=True)

    argv = [
        "bwrap", "--new-session",
        "--unshare-user", "--unshare-uts", "--unshare-cgroup-try",
        "--ro-bind", "/usr", "/usr", "--ro-bind", "/etc", "/etc",
        "--symlink", "usr/lib", "/lib", "--symlink", "usr/lib", "/lib64",
        "--symlink", "usr/bin", "/bin", "--symlink", "usr/bin", "/sbin",
        "--proc", "/proc", "--dev", "/dev",
        "--tmpfs", "/tmp", "--tmpfs", "/run", "--tmpfs", "/var", "--tmpfs", "/home",
        "--overlay-src", str(DS), "--overlay", str(upper), str(work), "/gw/ds",
    ]
    if not net:
        argv.append("--unshare-net")
    if not play:
        argv.append("--die-with-parent")  # a play session outlives the command that started it

    folders = MOUNT + (STOCK if os.environ.get("GW_MOUNT") == "all" else [])
    for name in folders:
        if (src / name).is_dir():
            argv += ["--ro-bind", str(src / name), f"/gw/ds/garrysmod/gamemodes/{name}"]

    argv += ["--ro-bind", str(REPO / "harness/addon/gw_harness"), "/gw/ds/garrysmod/addons/gw_harness"]
    argv += ["--bind", str(data), "/gw/ds/garrysmod/data/gw_harness"]
    mounted = [(workshop_id, path) for workshop_id, path in addons() if path.is_dir()]
    for workshop_id, path in mounted:
        argv += ["--ro-bind", str(path), f"/gw/ds/garrysmod/addons/ws_{workshop_id}"]

    home = "/home/gw"
    if play:
        # /gw/ipc holds the Unix sockets that cross the boundary: Steam's IPC port relayed
        # in, and a streamed session's VNC server relayed out (see portproxy.py).
        argv += ["--dev-bind", "/dev/dri", "/dev/dri", "--ro-bind", "/sys", "/sys",
                 "--ro-bind", str(TOOLS), "/gw/tools", "--bind", str(play["out"]), "/gw/out",
                 "--bind", str(play["ipc"]), "/gw/ipc",
                 "--ro-bind", str(REPO / "harness/session.sh"), "/gw/session.sh",
                 "--ro-bind", str(REPO / "harness/portproxy.py"), "/gw/portproxy.py"]
        client = play.get("client")
        if client:
            # The play session is a listen server: the game client hosts the gamemode
            # itself, so the checkout and the harness addon are mounted into the client.
            cupper, cwork = layer / "client-upper", layer / "client-work"
            for path in (cupper, cwork):
                path.mkdir(parents=True, exist_ok=True)
            argv += ["--overlay-src", str(client), "--overlay", str(cupper), str(cwork), "/gw/client"]
            for name in folders:
                if (src / name).is_dir():
                    argv += ["--ro-bind", str(src / name), f"/gw/client/garrysmod/gamemodes/{name}"]
            argv += ["--ro-bind", str(REPO / "harness/addon/gw_harness"), "/gw/client/garrysmod/addons/gw_harness",
                     "--bind", str(data), "/gw/client/garrysmod/data/gw_harness"]
            for workshop_id, path in mounted:
                argv += ["--ro-bind", str(path), f"/gw/client/garrysmod/addons/ws_{workshop_id}"]
            # The client must reach the Steam client running in the host session to pass
            # its ownership check, so it keeps the host's process and IPC namespaces and
            # sees the Steam directories read-only at their real paths. Steam's local IPC
            # port is relayed in through /gw/ipc; see portproxy.py.
            home = str(Path.home())
            argv += ["--dir", home, "--bind", "/dev/shm", "/dev/shm"]
            if compat_dir(play["client"]).is_dir():
                argv += ["--ro-bind", str(compat_dir(play["client"])), "/gw/compat"]
            for path in (Path.home() / ".steam", Path.home() / ".local/share/Steam"):
                if path.exists():
                    argv += ["--ro-bind", str(path), str(path)]
    if not (play and play.get("client")):
        argv += ["--unshare-pid", "--unshare-ipc", "--dir", home]

    argv += ["--setenv", "HOME", home, "--chdir", "/gw/ds"]
    return argv


def server_argv(map_name, port=27015):
    return [
        "env", "LD_LIBRARY_PATH=.:bin/linux64:linux64", "./bin/linux64/srcds", "-game", "garrysmod", "-console", "-norestart", "-nomaster",
        "-nohltv", "-disableluarefresh", "-condebug", "-ip", "127.0.0.1", "-port", str(port), "-maxplayers", "8",
        "+sv_lan", "1", "+sv_hibernate_think", "1", "+gamemode", GAMEMODE, "+map", map_name,
    ]


# --------------------------------------------------------------------------- headless


def scan_console(text):
    """Returns error blocks from a server console log: the matching line plus its stack."""
    lines = text.splitlines()
    blocks, i = [], 0
    while i < len(lines):
        if ERROR_LINE.search(lines[i]):
            block = [lines[i].rstrip()]
            i += 1
            while i < len(lines) and re.match(r"^\s+\d+\. ", lines[i]):
                block.append(lines[i].rstrip())
                i += 1
            blocks.append("\n".join(block))
        else:
            i += 1
    return blocks


def run_headless(src, name, map_name, timeout, only=None, mode="smoke"):
    """Boots the server on `src` in the sandbox and returns the result dict once the addon
    reports done in data/gw_harness/result.json.

    `mode` tells the addon what to do once the gamemode has settled: "smoke" runs the
    checks, "dump" writes registry.json (see dump.lua). Each `name` is its own layer and
    data directory under the run, so a dump and a headless run of one checkout can overlap.
    """
    layer = RUN / name
    rmtree(layer)
    data = layer / "data"
    data.mkdir(parents=True)
    (data / "config.json").write_text(json.dumps({
        "mode": mode, "quit": True, "gamemode": GAMEMODE, "roots": MOUNT, "only": only,
    }))

    stdout = layer / "stdout.log"
    started = time.time()
    with open(stdout, "wb") as log:
        proc = subprocess.Popen(
            sandbox(src, layer, data) + server_argv(map_name),
            stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True,
        )
        result_file = data / "result.json"
        timed_out = False
        while proc.poll() is None:
            if time.time() - started > timeout:
                timed_out = True
                break
            if '"done":true' in read_text(result_file).replace(" ", ""):
                try:
                    proc.wait(8)
                except subprocess.TimeoutExpired:
                    pass
                break
            time.sleep(0.5)
        if proc.poll() is None:
            os.killpg(proc.pid, signal.SIGTERM)
            try:
                proc.wait(10)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)

    console = layer / "upper/garrysmod/console.log"
    text = console.read_text(errors="replace") if console.exists() else stdout.read_text(errors="replace")
    try:
        result = json.loads(result_file.read_text())
    except (OSError, ValueError):
        result = {}

    result.update({
        "timed_out": timed_out,
        "seconds": round(time.time() - started, 1),
        "console_errors": scan_console(text),
        "console": text,
    })
    return result


def failures_of(result):
    """Flat, comparable set of failure strings for a headless result."""
    found = set()
    if not result.get("done"):
        found.add("server: did not finish the check run" + (" (timeout)" if result.get("timed_out") else ""))
    for check in result.get("checks", []):
        for failure in check.get("failures", []):
            found.add(f"{check['name']}: {failure}")
    for err in result.get("errors", []):
        found.add("lua error: " + err["error"])
    for block in result.get("console_errors", []):
        found.add("console: " + block.splitlines()[0].strip())
    return found


def write_headless(result, dest, label):
    dest.mkdir(parents=True, exist_ok=True)
    (dest / "console.log").write_text(result.pop("console", ""))
    (dest / "result.json").write_text(json.dumps(result, indent=2))
    lines = [f"### Headless run: {label}", "", f"Finished: {bool(result.get('done'))} in {result['seconds']}s", ""]
    if result.get("checks"):
        lines += ["| Check | Result | Detail |", "|---|---|---|"]
        for check in result["checks"]:
            detail = json.dumps(check.get("detail")) if check.get("detail") else ""
            status = "pass" if check["ok"] else f"**{len(check['failures'])} failed**"
            lines.append(f"| {check['name']} | {status} | `{detail}` |" if detail else f"| {check['name']} | {status} | |")
    (dest / "summary.md").write_text("\n".join(lines) + "\n")


def cmd_headless(args):
    need_install()
    say(f"headless boot of {REPO} (run {RUN_ID}, no network)")
    result = run_headless(REPO, "headless", args.map, args.timeout, args.only)
    mine = failures_of(result)
    write_headless(result, OUT / "headless", "this checkout")

    base = None
    if args.compare:
        base_src = RUN / "base-src"
        rmtree(base_src)
        base_src.mkdir(parents=True)
        ref = subprocess.run(["git", "-C", str(REPO), "merge-base", "HEAD", args.compare],
                             capture_output=True, text=True).stdout.strip() or args.compare
        say(f"headless boot of base {ref[:10]} for comparison")
        archive = subprocess.Popen(["git", "-C", str(REPO), "archive", ref] + MOUNT, stdout=subprocess.PIPE)
        subprocess.run(["tar", "-x", "-C", str(base_src)], stdin=archive.stdout, check=True)
        base_result = run_headless(base_src, "headless-base", args.map, args.timeout, args.only)
        base = failures_of(base_result)
        write_headless(base_result, OUT / "headless-base", f"base {ref[:10]}")

    new = sorted(mine - base) if base is not None else sorted(mine)
    fixed = sorted(base - mine) if base is not None else []
    known = sorted(mine & base) if base is not None else []
    verdict = {"pass": not new, "new": new, "fixed": fixed, "known": known}
    (OUT / "headless/verdict.json").write_text(json.dumps(verdict, indent=2))

    for check in result.get("checks", []):
        say(f"  {'ok  ' if check['ok'] else 'FAIL'} {check['name']}"
            + (f"  ({len(check['failures'])} failures)" if not check["ok"] else ""))
    if base is not None:
        say(f"{len(new)} new, {len(fixed)} fixed, {len(known)} already failing on base")
    for line in new[: args.show]:
        say(f"  new: {line}")
    if len(new) > args.show:
        say(f"  ... {len(new) - args.show} more in {OUT / 'headless/verdict.json'}")
    say(f"artifacts: {OUT / 'headless'}")
    say("PASS" if verdict["pass"] else "FAIL")
    return 0 if verdict["pass"] else 1


# --------------------------------------------------------------------------- lint

FINDING = re.compile(r"^(?P<path>.+?): \[(?P<severity>Error|Warning)\] line (?P<line>\d+), column \d+ - "
                     r"line \d+, column \d+: (?P<message>.*)$")
LINT_CRASH = re.compile(r"^glualint: (?P<path>[^:]+): ")
HOOK_FIRED = re.compile(r"""hook\.(?:Run|Call)\(\s*["']([A-Za-z_]\w*)["']""")
HOOK_DOCUMENTED = re.compile(r"^function\s+(?:\w+[:.])?(\w+)\s*\(", re.M)


def install_glualint():
    """Downloads the pinned glualint into the tools prefix. Returns whether it is there.

    The zip is checked against GLUALINT_SHA256 before anything is unpacked, so a changed
    or truncated download is refused rather than run.
    """
    if GLUALINT.exists():
        return True
    try:
        return fetch_glualint()
    except (OSError, KeyError, zipfile.BadZipFile) as err:
        say(f"could not install glualint: {err}")
        return False


def fetch_glualint():
    GLUALINT.parent.mkdir(parents=True, exist_ok=True)
    archive = GLUALINT.parent / "glualint.zip"
    fetched = subprocess.run(["curl", "-fsSL", "--max-time", "60", "-o", str(archive), GLUALINT_URL],
                             stderr=subprocess.DEVNULL).returncode == 0
    if not fetched:
        archive.unlink(missing_ok=True)
        return False
    digest = hashlib.sha256(archive.read_bytes()).hexdigest()
    if digest != GLUALINT_SHA256:
        archive.unlink()
        say(f"glualint download refused: sha256 {digest} is not the pinned {GLUALINT_SHA256}")
        return False
    with zipfile.ZipFile(archive) as zipped:
        GLUALINT.write_bytes(zipped.read("glualint"))
    GLUALINT.chmod(0o755)
    archive.unlink()
    return True


def need_glualint():
    """True when glualint can be run, fetching it on first use."""
    if GLUALINT.exists():
        return True
    say(f"glualint {GLUALINT_VERSION} is not installed; fetching it into {GLUALINT.parent}")
    return install_glualint()


def merge_base(ref):
    return git("merge-base", "HEAD", ref, check=False) or ref


def lua_files_under(paths):
    """Repository-relative .lua files at or under the given paths (relative to the cwd)."""
    files = []
    for name in paths:
        path = Path(name).resolve()
        try:
            path.relative_to(REPO)
        except ValueError:
            die(f"{name} is outside the repository")
        if path.is_dir():
            files += sorted(p for p in path.rglob("*.lua") if p.is_file())
        elif path.is_file():
            files.append(path)
        else:
            die(f"{name} does not exist")
    return [str(p.relative_to(REPO)) for p in files]


def changed_lines(base, files):
    """The lines each file has gained or changed against `base`, working tree included.

    Returns {path: set of line numbers}, with None for an untracked file (every line is
    new). A file absent from the result has no changes.
    """
    changed = {}
    untracked = set(git("ls-files", "--others", "--exclude-standard", "--", *LINTED, check=False).splitlines())
    tracked = [f for f in files if f not in untracked]
    for f in files:
        if f in untracked:
            changed[f] = None
    if not tracked:
        return changed
    current = None
    for line in git("diff", "-U0", "--no-color", "--no-ext-diff", base, "--", *tracked, check=False).splitlines():
        if line.startswith("+++ "):
            current = line[6:] if line.startswith("+++ b/") else None
        elif line.startswith("@@") and current:
            match = re.match(r"@@ -\S+ \+(\d+)(?:,(\d+))? @@", line)
            if match:
                start, count = int(match.group(1)), int(match.group(2) or 1)
                changed.setdefault(current, set()).update(range(start, start + count))
    return changed


def lint_targets(args):
    """The files to lint for these arguments: explicit paths, --all, or what the branch changed."""
    if args.paths:
        return lua_files_under(args.paths)
    if args.all:
        return [f for f in git("ls-files", "--", *(f"{root}/*.lua" for root in LINTED)).splitlines()
                if (REPO / f).is_file()]
    base = merge_base(args.base)
    names = git("diff", "--name-only", "--diff-filter=d", "--no-ext-diff", base, "--", *LINTED, check=False).splitlines()
    names += git("ls-files", "--others", "--exclude-standard", "--", *LINTED, check=False).splitlines()
    return sorted({f for f in names if f.endswith(".lua") and (REPO / f).is_file()})


def parse_glualint(output, rename=None):
    """Findings from glualint output as dicts, and the file it crashed on (or None).

    A message that runs over several lines is folded into one.
    """
    findings, crashed = [], None
    for line in output.splitlines():
        match = FINDING.match(line)
        if match:
            findings.append({"path": rename or match["path"], "line": int(match["line"]),
                             "severity": match["severity"].lower(), "message": match["message"].strip()})
        elif LINT_CRASH.match(line):
            crashed = LINT_CRASH.match(line)["path"]
        elif line.strip() and findings:
            findings[-1]["message"] += " " + line.strip()
    return findings, crashed


def glualint(argv, stdin=None):
    done = subprocess.run([str(GLUALINT), "--config", str(REPO / "glualint.json"), "lint"] + argv, cwd=REPO,
                          input=stdin, capture_output=True)
    return done.stdout.decode(errors="replace") + done.stderr.decode(errors="replace")


def lint_one(path):
    """Lints one file through stdin, decoded first: glualint aborts the whole run on a file
    that is not UTF-8 (some book items are cp1252), so such files never reach it raw."""
    raw = (REPO / path).read_bytes()
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        text = raw.decode("cp1252", errors="replace")
    return parse_glualint(glualint(["--stdin"], text.encode("utf-8")), rename=path)[0]


def run_lint(files):
    """glualint findings for the files: one run for the UTF-8 ones, one per other file.

    Should glualint still abort on something, every file is linted on its own instead, so a
    crash on one file never hides the findings of the rest or is reported as a finding.
    """
    plain, other = [], []
    for f in files:
        try:
            (REPO / f).read_bytes().decode("utf-8")
            plain.append(f)
        except UnicodeDecodeError:
            other.append(f)
    # glualint is single-threaded; a few runs side by side, balanced by size, halve the wait.
    chunks = [[] for _ in range(min(8, os.cpu_count() or 1, max(len(plain) // 40, 1)))]
    sizes = [0] * len(chunks)
    for f in sorted(plain, key=lambda f: -(REPO / f).stat().st_size):
        smallest = sizes.index(min(sizes))
        chunks[smallest].append(f)
        sizes[smallest] += (REPO / f).stat().st_size
    procs = [subprocess.Popen([str(GLUALINT), "--config", str(REPO / "glualint.json"), "lint"] + chunk, cwd=REPO,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT) for chunk in chunks if chunk]
    findings, crashed = [], None
    for proc in procs:
        found, crash = parse_glualint(proc.communicate()[0].decode(errors="replace"))
        findings += found
        crashed = crashed or crash
    if crashed:
        findings = [finding for f in plain for finding in lint_one(f)]
    for f in other:
        findings += lint_one(f)
    return findings


def plugin_ids(root=REPO):
    """Plugin uniqueIDs under ixhl2rp/plugins, as Helix derives them: a folder's name, or a
    single file's name without .lua. Mapped to the file a missing entry is reported at."""
    plugins = {}
    for path in sorted((root / GAMEMODE / "plugins").iterdir()):
        if path.is_dir():
            entry = path / "sh_plugin.lua"
            plugins[path.name] = str((entry if entry.exists() else path).relative_to(root))
        elif path.suffix == ".lua":
            plugins[path.stem] = str(path.relative_to(root))
    return plugins


def plugins_doc_findings(text, plugins, doc="docs/plugins.md"):
    """docs/plugins.md must have a table row whose first cell names each plugin as `id`."""
    listed = {}
    for number, line in enumerate(text.splitlines(), 1):
        cells = line.strip().split("|")
        if line.lstrip().startswith("|") and len(cells) > 2:
            for name in re.findall(r"`([^`]+)`", cells[1]):
                listed.setdefault(name, number)
    findings = [{"path": where, "line": 1, "severity": "warning",
                 "message": f"plugin `{name}` has no row in {doc}"}
                for name, where in sorted(plugins.items()) if name not in listed]
    findings += [{"path": doc, "line": number, "severity": "warning",
                  "message": f"row for `{name}`, which is not a plugin under {GAMEMODE}/plugins"}
                 for name, number in sorted(listed.items(), key=lambda item: item[1]) if name not in plugins]
    return findings


def fired_hooks(root):
    """{hook name: (path, line) of its first literal hook.Run/hook.Call} for .lua files under root."""
    fired = {}
    for path in sorted(root.rglob("*.lua")):
        for number, line in enumerate(read_text(path).splitlines(), 1):
            for name in HOOK_FIRED.findall(line):
                fired.setdefault(name, (str(path.relative_to(REPO)), number))
    return fired


def hooks_doc_findings(text, fired, known, doc="docs/hooks.lua"):
    """Every hook the project fires that Helix neither fires nor documents (`known`) needs a
    `function Name(` line in docs/hooks.lua. Reported where the hook is first fired."""
    documented = set(HOOK_DOCUMENTED.findall(text))
    return [{"path": path, "line": line, "severity": "warning",
             "message": f"hook {name} is fired here but not documented in {doc}"}
            for name, (path, line) in sorted(fired.items()) if name not in known and name not in documented]


def doc_findings():
    """Freshness warnings for docs/plugins.md and docs/hooks.lua; each skipped if absent."""
    findings = []
    plugins_md, hooks_lua = REPO / "docs/plugins.md", REPO / "docs/hooks.lua"
    if plugins_md.is_file():
        findings += plugins_doc_findings(read_text(plugins_md), plugin_ids())
    if hooks_lua.is_file():
        known = set(fired_hooks(REPO / "helix")) | set(
            name for path in (REPO / "helix/docs/hooks").glob("*.lua") for name in HOOK_DOCUMENTED.findall(read_text(path)))
        findings += hooks_doc_findings(read_text(hooks_lua), fired_hooks(REPO / GAMEMODE), known)
    return findings


def lint(files, base, every=False, docs=True):
    """Lints the files and prints one `path:line: severity: message` per finding shown.

    Errors are always shown. Warnings are shown only on lines changed against `base`
    unless `every` is set, so the output is about what was just edited; the documentation
    warnings are always shown. Returns the number of errors.
    """
    started = time.time()
    findings = run_lint(files) if files else []
    changed = {} if every else changed_lines(base, files)
    shown, hidden = [], 0
    for finding in findings:
        lines = changed.get(finding["path"], set())
        if every or finding["severity"] == "error" or lines is None or finding["line"] in lines:
            shown.append(finding)
        else:
            hidden += 1
    extra = doc_findings() if docs else []
    for finding in sorted(shown, key=lambda f: (f["path"], f["line"])) + extra:
        print(f"{finding['path']}:{finding['line']}: {finding['severity']}: {finding['message']}")
    errors = sum(1 for f in shown if f["severity"] == "error")
    warnings = len(shown) - errors
    scope = "" if every else " on changed lines"
    say(f"lint: {len(files)} file(s) in {time.time() - started:.2f}s, {errors} syntax error(s), {warnings} warning(s){scope}"
        + (f", {hidden} more on unchanged lines (--all-warnings)" if hidden else "")
        + (f", {len(extra)} documentation warning(s)" if extra else ""))
    return errors


def cmd_lint(args):
    if not need_glualint():
        die("glualint is not installed and could not be downloaded; run `harness/gw setup` with network access")
    files = lint_targets(args)
    return 1 if lint(files, merge_base(args.base), every=args.all_warnings) else 0


def lint_gate(base):
    """Finalize's first step: lint what the branch changed. Returns 1 on a syntax error.

    Without glualint and without network to fetch it, the lint is skipped, not failed.
    """
    if not need_glualint():
        say("lint skipped: glualint is not installed and could not be fetched (no network?)")
        return 0
    args = argparse.Namespace(paths=[], all=False, base=base)
    if lint(lint_targets(args), merge_base(base)):
        say("stopping before the server boot: fix the syntax error(s) above (`harness/gw lint` re-checks in a second)")
        return 1
    return 0


