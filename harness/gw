PLAY_OUT = OUT / "play"
RPC = {"sv": PLAY_OUT / "rpc", "cl": PLAY_OUT / "rpc"}
STEAM_IPC_PORT = 57343  # where the Steam client listens for games on this machine
CHECKOUT_HASH = int(hashlib.sha1(str(REPO).encode()).hexdigest(), 16)
SLOT_NUMBER = int(SLOT) if SLOT.isdigit() and int(SLOT) < 100 else None
PORT = 27100 + (SLOT_NUMBER if SLOT_NUMBER is not None else CHECKOUT_HASH % 800)
STREAM_BASE = 5900  # a streamed session listens on 5900 + slot: VNC display :<slot>
SESSION = PLAY_OUT / "session.json"
MARKS = PLAY_OUT / "marks.jsonl"
CLIENT_LOCK = HOME / "locks/game-client.lock"


def find_client():
    """The installed Garry's Mod client, or None. GW_CLIENT_DIR overrides the search."""
    override = os.environ.get("GW_CLIENT_DIR")
    roots = [Path(override)] if override else []
    steam = Path.home() / ".local/share/Steam"
    libraries = re.findall(r'"path"\s+"([^"]+)"', read_text(steam / "steamapps/libraryfolders.vdf"))
    roots += [Path(lib) / "steamapps/common/GarrysMod" for lib in [str(steam)] + libraries]
    for root in roots:
        if (root / "garrysmod/gameinfo.txt").exists():
            return root
    return None


def play_pid():
    try:
        pid = int(read_text(PLAY / "pid"))
        os.kill(pid, 0)
        return pid
    except (ValueError, OSError):
        return None


def session_alive():
    """True while the session loop is beating. Works from inside another sandbox, where
    the session's process cannot be seen or signalled."""
    try:
        return time.time() - (PLAY_OUT / "alive").stat().st_mtime < 5 and not (PLAY_OUT / "stop").exists()
    except OSError:
        return False


def phase():
    return read_text(PLAY_OUT / "phase").strip()


def lock_holder(path=CLIENT_LOCK):
    """Who holds the lock at `path`, as the holder recorded it, or None when nobody does.

    A lock is a flock(2) on its file, held through a descriptor the session's processes
    inherit, so the kernel releases it when the last of them exits, however the session ends.
    """
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return None
    try:
        for attempt in range(3):
            try:
                fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except BlockingIOError:
                time.sleep(0.05)
                continue
            fcntl.flock(fd, fcntl.LOCK_UN)
            return None
        try:
            return json.loads(os.pread(fd, 65536, 0) or b"{}")
        except ValueError:
            return {}
    finally:
        os.close(fd)


def take_lock(path, holder, wait):
    """Takes the lock at `path` for `holder`. Returns the descriptor that holds it, or None
    when someone else has it and `wait` is off; with `wait` it blocks until it is free."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    tries = 0
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            tries += 1
            if not wait and tries >= 3:  # a passing lock_holder() probe holds it for an instant
                os.close(fd)
                return None
            if wait and tries == 3:
                say(f"waiting for the game client, in use by {describe_holder(lock_holder(path))}")
            time.sleep(0.05 if tries < 3 else 1)
    holder["since"] = now_iso()
    record_holder(fd, holder)
    return fd


def record_holder(fd, holder):
    os.ftruncate(fd, 0)
    os.pwrite(fd, json.dumps(holder).encode(), 0)


def describe_holder(holder):
    if not holder:
        return "another process"
    return f"{holder.get('by', 'someone')} in {holder.get('checkout', '?')} since {holder.get('since', '?')}"


def client_locks(needed):
    """How a session stands with the game-client lock, as the session verbs report it."""
    holder = lock_holder()
    return [{"name": "game-client", "path": str(CLIENT_LOCK), "needed": needed,
             "held": holder is not None, "holder": holder}]


def tailnet_address():
    """This machine's Tailscale IPv4 address, or None without Tailscale or a connection."""
    if not shutil.which("tailscale"):
        return None
    try:
        done = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    found = done.stdout.split() if done.returncode == 0 else []
    return found[0] if found else None


def stream_port(address):
    """5900 + the slot, or without one the first port from a per-checkout start in
    5900-5999 that `address` can bind; None when there is none."""
    if SLOT_NUMBER is not None:
        candidates = [STREAM_BASE + SLOT_NUMBER]
    else:
        candidates = [STREAM_BASE + (CHECKOUT_HASH + n) % 100 for n in range(100)]
    for port in candidates:
        with socket.socket(socket.AF_INET6 if ":" in address else socket.AF_INET) as probe:
            probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)  # as the relay binds it
            try:
                probe.bind((address, port))
                return port
            except OSError:
                continue
    return None


def stream_settings(args, ipc):
    """Picks the stream's address and port and writes the VNC server's config with a new
    password into `ipc`, which only the sandbox and this user can read. Returns the attach
    details a client needs."""
    tailnet = tailnet_address()
    address = args.listen or tailnet or "127.0.0.1"
    port = stream_port(address)
    if not port:
        die(f"no free stream port on {address}" + (f" (slot {SLOT_NUMBER} wants {STREAM_BASE + SLOT_NUMBER})"
                                                    if SLOT_NUMBER is not None else " in 5900-5999"), 1)
    password = secrets.token_urlsafe(6)[:8]  # VNC authentication reads at most 8 characters
    # DES "VNC authentication" is what stock viewers and noVNC all speak. The stream is
    # reachable only on loopback or the tailnet, which WireGuard already encrypts. Never
    # relax_encryption: it offers Apple DH, whose handshake from gtk-vnc aborts neatvnc 1.0.3.
    config = ipc / "wayvnc.conf"
    config.write_text(f"enable_auth=true\nallow_broken_crypto=true\npassword={password}\n")
    config.chmod(0o600)
    network = ("loopback" if address.startswith("127.") or address == "::1" else
               "all-interfaces" if address in ("0.0.0.0", "::") else
               "tailnet" if address == tailnet else "other")
    if network == "all-interfaces":
        say(f"warning: the stream listens on every interface ({address}:{port}), not only the tailnet")
    return {"protocol": "vnc", "host": address, "port": port, "display": port - STREAM_BASE, "password": password,
            "url": f"vnc://{address}:{port}", "network": network, "pointer": "absolute"}


def start_session(args):
    """Starts this checkout's play session and returns what session.json records about it,
    with the attach details and the state of the game-client lock.

    With the real game client it first takes the machine-wide game-client lock, which the
    session's processes then hold for as long as any of them runs; `--client-cmd` sessions
    take no lock. A streamed session also runs a VNC server on the private compositor and
    relays it out on one TCP port (see "Streamed sessions" in harness/README.md).
    """
    need_install()
    streamed = bool(getattr(args, "streamed", False)) or getattr(args, "by", None) == "person"
    by = getattr(args, "by", None) or ("person" if streamed else "agent")
    if not (TOOLS / "usr/bin/sway").exists():
        die("session tools missing; run `harness/gw setup`")
    if streamed and not (TOOLS / "usr/bin/wayvnc").exists():
        die("a streamed session needs wayvnc in the tools prefix; run `harness/gw setup`")
    if session_running():
        die("a play session for this checkout is already running; `harness/gw session stop` first")

    client = find_client()
    sid = f"{RUN_ID}-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}"
    holder = {"checkout": str(REPO), "by": by, "since": now_iso(), "session": sid}
    lock_fd = None
    if not args.client_cmd and client:
        lock_fd = take_lock(CLIENT_LOCK, holder, getattr(args, "wait", False))
        if lock_fd is None:
            die(f"the game client is in use by {describe_holder(lock_holder())}; `--wait` queues for it", 75,
                locks=client_locks(True))
    if args.client_cmd:
        client_cmd, client = args.client_cmd, None
    elif client:
        width, height = args.res.split("x")
        client_cmd = (f"cd /gw/client && SteamAppId=4000 SteamGameId=4000 LD_LIBRARY_PATH=/gw/compat exec ./hl2.sh "
                      f"-steam -game garrysmod -windowed -noborder -w {width} -h {height} -novid -console -condebug "
                      f"-nojoy -noworkshop +sv_lan 1 +maxplayers 8 +gamemode {GAMEMODE} +map {args.map}")
    else:
        die("Garry's Mod client not found in any Steam library (install app 4000, or set GW_CLIENT_DIR). "
            "The headless stage does not need it.")

    stop_relays()
    rmtree(PLAY)
    rmtree(PLAY_OUT)
    for path in (PLAY, PLAY_OUT, RPC["sv"]):
        path.mkdir(parents=True)
    (RPC["sv"] / "config.json").write_text(json.dumps({"mode": "play", "gamemode": GAMEMODE, "roots": MOUNT}))

    env = dict(os.environ, GW_RES=args.res, GW_FPS=str(args.fps), GW_CLIENT=client_cmd)
    ipc = PLAY / "ipc"
    ipc.mkdir(mode=0o700)
    attach = None
    if streamed:
        attach = stream_settings(args, ipc)
        env.update(GW_STREAM="1", GW_STREAM_FPS=str(args.stream_fps))
    if client:
        # Relay the Steam client's local IPC port into the sandbox; see portproxy.py.
        relay = subprocess.Popen([sys.executable, str(REPO / "harness/portproxy.py"), "host", str(ipc / "steam.sock"),
                                  str(STEAM_IPC_PORT)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
        (PLAY / "relay.pid").write_text(str(relay.pid))
        env["GW_STEAM_PORT"] = str(STEAM_IPC_PORT)
    if not client and not args.no_server:
        # Without the game client (a stand-in command) a dedicated server is started so
        # the server command channel can still be used.
        env["GW_SERVER"] = " ".join(server_argv(args.map, PORT)[2:])
    argv = sandbox(REPO, PLAY, RPC["sv"], net=os.environ.get("GW_PLAY_NET") == "host",
                   play={"out": PLAY_OUT, "client": client, "ipc": ipc})
    with open(PLAY_OUT / "session.log", "wb") as log:
        proc = subprocess.Popen(argv + ["/gw/session.sh"], env=env, stdin=subprocess.DEVNULL, stdout=log,
                                stderr=subprocess.STDOUT, start_new_session=True,
                                pass_fds=(lock_fd,) if lock_fd is not None else ())
    (PLAY / "pid").write_text(str(proc.pid))
    if lock_fd is not None:
        record_holder(lock_fd, dict(holder, pid=proc.pid))
        os.close(lock_fd)  # the session's processes hold it from here on
    info = {"id": sid, "by": by, "checkout": str(REPO), "head": git("rev-parse", "HEAD", check=False),
            "startedAt": now_iso(), "slot": SLOT_NUMBER, "client": "game" if client else "command",
            "streamed": streamed, "recording": str(PLAY_OUT / "session.mkv"), "marks": str(MARKS)}
    SESSION.write_text(json.dumps(info, indent=1) + "\n")
    say(f"play session starting (pid {proc.pid}, port {PORT}, {args.res}); logs in {PLAY_OUT}")

    def failed(message):
        stop_session()
        die(message, 1, locks=client_locks(bool(client)))

    deadline = time.time() + args.timeout
    while time.time() < deadline:
        if proc.poll() is not None or phase().startswith("failed"):
            failed(f"session ended during startup ({phase() or 'no phase'}); see {PLAY_OUT / 'session.log'}")
        if phase() == "running":
            break
        time.sleep(0.3)
    else:
        failed("session did not reach the running phase in time")
    inner = read_text(f"/proc/{proc.pid}/task/{proc.pid}/children").split()
    if inner:
        (PLAY / "inner.pid").write_text(inner[0])

    if attach:
        # The VNC server listens on a Unix socket in /gw/ipc; this relays one TCP address to it.
        with open(PLAY_OUT / "stream-relay.log", "wb") as log:
            relay = subprocess.Popen([sys.executable, str(REPO / "harness/portproxy.py"), "expose", str(ipc / "vnc.sock"),
                                      attach["host"], str(attach["port"])], stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=log, start_new_session=True)
        (PLAY / "stream.pid").write_text(str(relay.pid))
        for _ in range(50):
            if relay.poll() is not None:
                failed(f"the stream relay could not listen on {attach['host']}:{attach['port']}; "
                       f"see {PLAY_OUT / 'stream-relay.log'}")
            try:
                socket.create_connection((attach["host"], attach["port"]), timeout=1).close()
                break
            except OSError:
                time.sleep(0.1)
        stream = PLAY / "stream.json"
        stream.write_text(json.dumps(attach))
        stream.chmod(0o600)
        say(f"streaming on {attach['url']} (password {attach['password']})")

    if client:
        say("waiting for the game to load the map")
        while time.time() < deadline:
            try:
                if rpc("cl", "state", timeout=5).get("connected"):
                    break
            except RpcError:
                pass
            if proc.poll() is not None:
                failed(f"the game exited while loading; see {PLAY_OUT / 'client.log'}")
        else:
            failed(f"the game did not finish loading within {args.timeout}s; see {PLAY_OUT / 'client.log'}")
    say("session running")
    return dict(info, attach=attach, locks=client_locks(bool(client)))


