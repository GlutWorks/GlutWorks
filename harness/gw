ATTACH_MAX_FILES = 50    # per gh command
HIGHLIGHT_MAX = 8        # things shown on the pull request
CLIP_SECONDS = 10        # the longest one highlight runs in the reel; longer spans are sped up
CLIP_MARGIN = 1.5        # seconds kept before the first and after the last screenshot of a clip


def media_ref(path):
    """How the report and `gh --attach` both name a media file: its path relative to .gw."""
    return "./" + str(path.relative_to(OUT))


def gh_can_attach():
    return "--attach" in subprocess.run(["gh", "pr", "edit", "--help"], capture_output=True, text=True).stdout


def parse_playtest(text):
    """The HIGHLIGHT, BLOCKER and NOTE lines of the playtest agent's report (see playtest.md)."""
    highlights = []
    for title, sentence, media in re.findall(
            r"^[ \t]*(?:[-*][ \t]*)?HIGHLIGHT:[ \t]*(.+?)[ \t]*\|[ \t]*(.+?)[ \t]*\|[ \t]*`?([^\s`|]+)`?[ \t]*$", text, re.M):
        first, _, last = media.replace(".jpg", "").partition("..")
        highlights.append({"title": title.strip("*` "), "text": sentence, "from": first, "to": last or first})
    def lines(kind):
        return re.findall(rf"^[ \t]*(?:[-*][ \t]*)?{kind}:[ \t]*(.+?)[ \t]*$", text, re.M)

    return {"highlights": highlights[:HIGHLIGHT_MAX], "blockers": lines("BLOCKER"), "notes": lines("NOTE")}


def find_shot(name):
    """A screenshot by the name the agent gave it, with or without its counter prefix."""
    shots = PLAY_OUT / "shots"
    if (shots / f"{name}.jpg").exists():
        return shots / f"{name}.jpg"
    return next(iter(sorted(shots.glob(f"*_{name}.jpg"))), None)


def clip_range(item, began, length):
    """(startMs, endMs) in the recording for a highlight that spans two screenshots, else None.

    A screenshot's place in the recording is its file time measured from the recording's
    start; CLIP_MARGIN is kept on either side.
    """
    first, last = find_shot(item["from"]), find_shot(item["to"])
    if not first or not last or first == last:
        return None
    start = round(max(first.stat().st_mtime - began - CLIP_MARGIN, 0.0) * 1000)
    end = round(min(last.stat().st_mtime - began + CLIP_MARGIN, length) * 1000)
    return (start, end) if end - start >= 1000 else None


def cut(start_ms, end_ms, dest, vf=None):
    """Encodes startMs..endMs of the session recording to dest; returns dest, or None if nothing came out."""
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", f"{start_ms / 1000:.3f}", "-t", f"{(end_ms - start_ms) / 1000:.3f}",
                    "-i", str(PLAY_OUT / "session.mkv"), "-map_metadata", "-1"] + (["-vf", vf] if vf else []) +
                   ["-c:v", "libx264", "-preset", "medium", "-crf", "27", "-pix_fmt", "yuv420p", "-movflags", "+faststart",
                    "-an", str(dest)], stderr=subprocess.DEVNULL, check=False)
    return dest if dest.exists() and dest.stat().st_size else None


def still(at_ms, dest):
    """The recording's frame at atMs as a JPEG; returns dest, or None if nothing came out."""
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", f"{at_ms / 1000:.3f}", "-i", str(PLAY_OUT / "session.mkv"),
                    "-frames:v", "1", "-map_metadata", "-1", "-q:v", "3", str(dest)], stderr=subprocess.DEVNULL, check=False)
    return dest if dest.exists() and dest.stat().st_size else None


def mark_media(marks):
    """The media for each mark: a clip of exactly startMs..endMs for a range, the screenshot
    taken with it, and for a moment without one the recording's frame at that moment.
    Returns {mark id: [("clip", path, startMs, endMs) | ("image", path)]}.
    """
    raw, clips = PLAY_OUT / "session.mkv", PLAY_OUT / "clips"
    length = round(media_seconds(raw) * 1000) if raw.exists() else 0
    clips.mkdir(exist_ok=True)
    found = {}
    for mark in marks:
        items = []
        if length and "startMs" in mark:
            start, end = min(mark["startMs"], length), min(mark["endMs"], length)
            part = end - start >= 200 and cut(start, end, clips / f"mark-{mark['id']}.mp4")
            if part:
                items.append(("clip", part, start, end))
        shot = PLAY_OUT / mark["shot"] if mark.get("shot") else None
        if shot and shot.is_file():
            items.append(("image", shot))
        elif length and "atMs" in mark:
            frame = still(min(mark["atMs"], length - 1), clips / f"mark-{mark['id']}.jpg")
            if frame:
                items.append(("image", frame))
        found[mark["id"]] = items
    return found


def cut_clips(highlights):
    """Cuts the packet's clip for every highlight that spans two screenshots: exactly that
    stretch of the recording, in real time and without a caption, so a time in the clip is
    startMs plus that time in the recording, and its bytes change only when the stretch does.
    Returns {highlight index: (clip path, startMs, endMs)}.
    """
    raw, clips = PLAY_OUT / "session.mkv", PLAY_OUT / "clips"
    rmtree(clips)
    length = media_seconds(raw) if raw.exists() else 0.0
    if not length:
        return {}
    # Without the session's note of its first frame, the recorder wrote until the session stopped.
    began = recording_began() or raw.stat().st_mtime - length
    clips.mkdir()
    parts = {}
    for index, item in enumerate(highlights):
        span = clip_range(item, began, length)
        part = span and cut(*span, clips / f"{index}.mp4")
        if part:
            parts[index] = (part, *span)
    return parts


def build_reel(items):
    """Joins a captioned clip for each (caption, startMs, endMs) into reel.mp4 for the pull
    request; a span longer than CLIP_SECONDS is sped up to fit. Returns the reel, or None
    without clips or when it is too big to attach.
    """
    reel, clips = PLAY_OUT / "reel.mp4", PLAY_OUT / "reel-clips"
    reel.unlink(missing_ok=True)
    rmtree(clips)
    if not items or not (PLAY_OUT / "session.mkv").exists():
        return None
    clips.mkdir(parents=True)
    parts = []
    for index, (title, start_ms, end_ms) in enumerate(items):
        speed = max(1.0, (end_ms - start_ms) / 1000 / CLIP_SECONDS)
        caption = clips / f"{index}.txt"
        caption.write_text(title + (f"  ({speed:.0f}x)" if speed >= 1.5 else ""))
        part = cut(start_ms, end_ms, clips / f"{index}.mp4",
                   f"setpts=PTS/{speed:.3f},fps=20,scale=960:-2,drawtext=textfile={caption}:x=24:y=h-th-24:fontsize=28:"
                   "fontcolor=white:box=1:boxcolor=black@0.6:boxborderw=12")
        if part:
            parts.append(part)
    if not parts:
        return None
    (clips / "list.txt").write_text("".join(f"file '{part}'\n" for part in parts))
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-f", "concat", "-safe", "0", "-i", str(clips / "list.txt"),
                    "-c", "copy", "-movflags", "+faststart", str(reel)], stderr=subprocess.DEVNULL, check=False)
    if not reel.exists() or not 0 < reel.stat().st_size <= ATTACH_LIMIT:
        reel.unlink(missing_ok=True)
        return None
    return reel


PACKET = OUT / "packet"
MEDIA_TYPES = {".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".png": "image/png", ".mp4": "video/mp4"}
STATUS_CONTEXT = "gw/finalize"
STATUS_STATES = {"pass": "success", "fail": "failure", "blocked": "error"}


def sha256_of(path):
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def probe(path):
    """width, height and, for a video, durationMs as ffprobe reports them; what it cannot tell is left out."""
    try:
        data = json.loads(subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height:format=duration",
             "-of", "json", str(path)], capture_output=True, text=True, timeout=30).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}
    stream = (data.get("streams") or [{}])[0]
    found = {}
    try:
        if MEDIA_TYPES.get(path.suffix.lower(), "").startswith("video/"):
            found["durationMs"] = round(float(data["format"]["duration"]) * 1000)
    except (KeyError, TypeError, ValueError):
        pass
    found.update({key: stream[key] for key in ("width", "height") if isinstance(stream.get(key), int)})
    return found


def repository():
    """owner/name of the origin remote, as GitHub names it."""
    url = git("remote", "get-url", "origin", check=False)
    match = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?/?$", url)
    return match.group(1) if match else url


def build_packet(args):
    """Assembles .gw/packet/: packet.json and the media it references, named by SHA-256.

    Everything but the claims is derived here: the revision from git, the status from the
    headless verdict and the playtest, and each claim's result and evidence from the
    playtest's HIGHLIGHT and BLOCKER lines. A highlight that names no claim becomes a note
    with its evidence. A media file already in the packet is never rewritten, and files no
    longer referenced are removed. Returns the packet.
    """
    claims = load_claims(args)
    base = base_ref(args)
    head = git("rev-parse", "HEAD")
    base_sha = git("merge-base", "HEAD", base, check=False)
    if not base_sha:
        die(f"HEAD has no merge-base with {base}; `git fetch origin` first")
    change = {"repository": repository(), "branch": git("rev-parse", "--abbrev-ref", "HEAD"),
              "base": base.removeprefix("origin/")}
    if getattr(args, "pr", None):
        change["pullRequest"] = args.pr
    for claim in claims["claims"]:
        for path in claim["paths"]:
            if not git("diff", "--name-only", base_sha, "HEAD", "--", path, check=False):
                say(f"warning: claim {claim['id']}: the change touches nothing under {path}", sys.stderr)

    verdict = json.loads(read_text(OUT / "headless/verdict.json") or "{}")
    result = json.loads(read_text(OUT / "headless/result.json") or "{}")
    play = json.loads(read_text(PLAY_OUT / "playtest.json") or "{}")
    session = json.loads(read_text(SESSION) or "{}")
    marks = load_marks()
    # A person's session is a playtest without an agent report: its marks are the findings.
    person = not play and session.get("by") == "person" and (marks or (PLAY_OUT / "session.mkv").exists())
    played_at = play.get("head") or (session.get("head") if person else None)
    if played_at and not head.startswith(played_at):
        say(f"warning: the playtest was recorded at {played_at[:10]}, not at HEAD {head[:10]}", sys.stderr)
    failed = (verdict and not verdict.get("pass")) or play.get("verdict") == "fail"
    blocked = not (verdict or play or person) or play.get("verdict") == "blocked"
    status = {"verdict": "fail" if failed else "blocked" if blocked else "pass"}
    if verdict:
        status["checks"] = {"passed": sum(1 for check in result.get("checks", []) if check.get("ok")),
                            "newFailures": len(verdict.get("new", [])), "knownFailures": len(verdict.get("known", []))}
    if play:
        status["playtest"] = {"by": "agent", **({"model": play["model"]} if play.get("model") else {})}
    elif person:
        status["playtest"] = {"by": "person"}

    by_id = {claim["id"]: claim for claim in claims["claims"]}
    names = {key: key for key in by_id}
    for claim in claims["claims"]:
        names.setdefault(slug(claim["title"]), claim["id"])

    def claim_for(name):
        name = name.strip("`*_ ")
        return name if name in by_id else names.get(slug(name))

    highlights = play.get("highlights") or []
    for item in highlights:
        item["claim"] = claim_for(item["title"])
    clips = cut_clips(highlights) if highlights else {}
    marked = mark_media(marks) if marks else {}
    recording = ("sha256:" + sha256_of(PLAY_OUT / "session.mkv")
                 if clips or any(kind == "clip" for items in marked.values() for kind, *_ in items) else None)

    (PACKET / "media").mkdir(parents=True, exist_ok=True)
    media = {}

    def add_media(path):
        digest = sha256_of(path)
        key = "sha256:" + digest
        if key not in media:
            dest = PACKET / "media" / (digest + path.suffix.lower())
            if not dest.exists():
                tmp = dest.with_name(dest.name + ".tmp")
                shutil.copyfile(path, tmp)
                tmp.rename(dest)
            media[key] = {"id": key, "file": f"media/{dest.name}", "type": MEDIA_TYPES.get(dest.suffix, "application/octet-stream"),
                          "bytes": dest.stat().st_size, **probe(dest)}
        return key

    used, evidence, observed, notes = set(), {}, {}, []
    for index, item in enumerate(highlights):
        owner, found = item["claim"] or slug(item["title"]), []
        if index in clips:
            clip, start, end = clips[index]
            found.append({"id": unique(f"{owner}-clip", used), "kind": "clip", "media": add_media(clip),
                          "recording": recording, "startMs": start, "endMs": end})
        shot = find_shot(item["to"])
        if shot:
            found.append({"id": unique(f"{owner}-shot", used), "kind": "image", "media": add_media(shot)})
        if item["claim"]:
            evidence.setdefault(item["claim"], []).extend(found)
            observed.setdefault(item["claim"], item["text"])
        else:
            notes.append({"text": f"{item['title']}: {item['text']}", "evidence": found})

    # A mark naming a claim is evidence on it, with its note as what was observed when the
    # playtest gave nothing better; any other mark is a note with its evidence. The packet
    # has no field for a mark's region or author; harness/README.md lists what is left out.
    for mark in marks:
        claim, found = (claim_for(mark["claim"]) if mark.get("claim") else None), []
        owner = claim or "mark"
        for kind, path, *span in marked.get(mark["id"], []):
            if kind == "clip":
                found.append({"id": unique(f"{owner}-{mark['id']}-clip", used), "kind": "clip", "media": add_media(path),
                              "recording": recording, "startMs": span[0], "endMs": span[1]})
            else:
                found.append({"id": unique(f"{owner}-{mark['id']}-shot", used), "kind": "image", "media": add_media(path),
                              "caption": mark["note"]})
        if claim:
            evidence.setdefault(claim, []).extend(found)
            observed.setdefault(claim, mark["note"])
        else:  # a claim id the claims no longer have stays readable in the note
            notes.append({"text": f"{mark['claim']}: {mark['note']}" if mark.get("claim") else mark["note"],
                          "evidence": found})

    blockers, not_seen = [], {}
    for text in play.get("blockers") or []:
        match = re.match(r"^`?([a-z0-9-]+)`?[ \t]*\|[ \t]*(.+)$", text)
        if match and match.group(1) in by_id:
            text = match.group(2)
            not_seen.setdefault(match.group(1), text)
        blockers.append({"text": text, "evidence": []})
    notes += [{"text": note, "evidence": []} for note in play.get("notes") or []]

    out = []
    for claim in claims["claims"]:
        cid = claim["id"]
        entry = {"id": cid, "title": claim["title"], "statement": claim["statement"],
                 "result": "not-seen" if cid in not_seen else "seen" if cid in observed else "untested"}
        if not_seen.get(cid) or observed.get(cid):
            entry["observed"] = not_seen.get(cid) or observed[cid]
        out.append({**entry, "evidence": evidence.get(cid, []), "paths": claim["paths"]})

    packet = {"schema": 1, "change": change,
              "revision": {"base": base_sha, "head": head, "recordedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}}
    if claims["summary"]:
        packet["summary"] = claims["summary"]
    packet.update(status=status, claims=out, blockers=blockers, notes=notes, media=list(media.values()))
    for stale in (PACKET / "media").iterdir():
        if "sha256:" + stale.name.split(".")[0] not in media or stale.name.endswith(".tmp"):
            stale.unlink()
    tmp = PACKET / "packet.json.tmp"
    tmp.write_text(json.dumps(packet, indent=1, ensure_ascii=False) + "\n")
    tmp.rename(PACKET / "packet.json")
    return packet


def cmd_packet(args):
    packet = build_packet(args)
    results = [claim["result"] for claim in packet["claims"]]
    print(PACKET / "packet.json")
    print(json.dumps({"verdict": packet["status"]["verdict"], "head": packet["revision"]["head"], "claims": len(results),
                      "seen": results.count("seen"), "notSeen": results.count("not-seen"), "untested": results.count("untested"),
                      "blockers": len(packet["blockers"]), "notes": len(packet["notes"]), "media": len(packet["media"])}))
    return 0


def status_description(packet):
    """`130 checks pass · playtest pass`: the commit status's one line, from the packet."""
    status, checks = packet["status"], packet["status"].get("checks")
    if not checks:
        part = "checks not run"
    elif checks["newFailures"]:
        part = f"{checks['newFailures']} new check failure(s)"
    else:
        part = f"{checks['passed']} checks pass"
    if not status.get("playtest"):
        played = "no playtest"
    elif packet["blockers"]:
        played = f"playtest: {len(packet['blockers'])} blocker(s)"
    elif status["verdict"] in ("pass", "blocked"):
        played = f"playtest {status['verdict']}"
    else:
        played = "playtest: no blockers"
    return f"{part} · {played}"


def post_status(packet, dry_run=False):
    """Reports the verdict as a commit status on the head commit. A failure to post is a warning."""
    sha, state, description = packet["revision"]["head"], STATUS_STATES[packet["status"]["verdict"]], status_description(packet)
    if dry_run:
        say(f"dry run: would post commit status {STATUS_CONTEXT} = {state} ({description}) on {sha[:10]}")
        return
    done = subprocess.run(["gh", "api", "--method", "POST", f"repos/{packet['change']['repository']}/statuses/{sha}",
                           "-f", f"state={state}", "-f", f"context={STATUS_CONTEXT}", "-f", f"description={description[:140]}"],
                          cwd=REPO, capture_output=True, text=True)
    if done.returncode:
        say(f"warning: commit status not posted on {sha[:10]}: {(done.stderr.strip() or 'gh api failed')[:300]}")
    else:
        say(f"commit status {STATUS_CONTEXT} = {state} ({description}) posted on {sha[:10]}")


def build_report(embed=True):
    """Assembles the Markdown that goes into the pull request from whatever stages ran.

    It is rendered from .gw/packet/packet.json (build_packet first) and deliberately short:
    one short video and one screenshot per claim the playtest saw. The verdict is a commit
    status, not part of the report. The full check list and the playtest agent's whole
    report stay in .gw. Media is referenced by its path relative to .gw, which
    `gh --attach` rewrites to the uploaded asset; with embed off it is left out.
    Returns the report and the media files it references.
    """
    media = []

    def ref(path):
        media.append(path)
        return media_ref(path)

    packet = json.loads(read_text(PACKET / "packet.json") or "{}")
    files = {item["id"]: PACKET / item["file"] for item in packet.get("media", [])}
    play = packet.get("status", {}).get("playtest")
    lines = [START, ""]

    if play:
        claims = packet["claims"]
        who = "session" if play.get("by") == "person" else "playtest"
        shown = [{"title": c["title"], "text": c.get("observed", ""), "evidence": c["evidence"]} for c in claims if c["result"] == "seen"]
        for note in packet["notes"]:
            if note["evidence"]:
                title, colon, text = note["text"].partition(": ")
                shown.append({"title": title if colon else "Note", "text": text if colon else title, "evidence": note["evidence"]})
        hidden, shown = shown[HIGHLIGHT_MAX:], shown[:HIGHLIGHT_MAX]
        for item in shown:
            item["shot"] = next((files.get(e["media"]) for e in item["evidence"] if e["kind"] == "image"), None)
        clips = [(item["title"], e["startMs"], e["endMs"]) for item in shown for e in item["evidence"] if e["kind"] == "clip"]
        reel = build_reel(clips) if embed else None
        whole = PLAY_OUT / "session.mp4"
        if reel:
            lines += [f"![]({ref(reel)})", ""]  # alone in its paragraph, so it renders as a player
        elif embed and whole.exists() and whole.stat().st_size <= ATTACH_LIMIT:
            speed = float(read_text(PLAY_OUT / "speed.txt") or 1)
            lines += [f"The whole session{f', sped up {speed:.0f}x' if speed > 1 else ''}:", "", f"![]({ref(whole)})", ""]

        def cell(text):
            return text.replace("|", "\\|").replace("\n", " ")

        for start in range(0, len(shown), 2):
            pair = shown[start:start + 2]
            shots = [item["shot"] if embed else None for item in pair]
            lines += ["| " + " | ".join(cell(item["title"]) for item in pair) + " |",
                      "|" + "---|" * len(pair)]
            if any(shots):
                lines.append("| " + " | ".join(f"![{cell(item['title'])}]({ref(shot)})" if shot else ""
                                               for item, shot in zip(pair, shots)) + " |")
            lines += ["| " + " | ".join(cell(item["text"]) for item in pair) + " |", ""]
        if not shown:
            lines += ["_No marks were made in the session._" if who == "session" else
                      "_The playtest named no highlights; its report is in `.gw/play/playtest.md`._", ""]
        if hidden:
            lines += [f"_{len(hidden)} more with evidence in the packet: {', '.join(item['text'] for item in hidden)[:300]}._", ""]
        unseen = [c["title"] for c in claims if c["result"] != "seen"]
        if unseen:
            lines += [f"_Not shown by the {who}: {', '.join(unseen)}._", ""]

        # Blockers are the playtest's only findings that count against the change. Notes are
        # the playtester's suggestions; whether to act on them is the author's call.
        blockers = [blocker["text"] for blocker in packet["blockers"]]
        notes = [note["text"] for note in packet["notes"] if not note["evidence"]]
        if blockers:
            lines += [f"**Blocking:** {blocker}" for blocker in blockers] + [""]
        if notes:
            lines += [f"<details><summary>{len(notes)} playtester note(s): suggestions, not requirements</summary>", ""]
            lines += [f"- {note}" for note in notes] + ["", "</details>", ""]
        errors = json.loads(read_text(PLAY_OUT / "server-errors.json") or "[]")
        if errors:
            lines += [f"<details><summary>{len(errors)} error(s) in the game console during play</summary>", "", "```"]
            lines += errors[:20] + ["```", "", "</details>", ""]
    lines.append(END)
    (OUT / "report.md").write_text("\n".join(lines) + "\n")
    return OUT / "report.md", media


def cmd_report(args):
    build_packet(args)
    print(build_report()[0])
    return 0


def cmd_publish(args):
    build_packet(args)
    return publish(args)


def publish(args):
    """Writes the report into the pull request body, with its media attached to the PR, and
    posts the verdict as a commit status on the head commit. The packet must be built.

    `gh pr edit --attach` uploads the media as GitHub attachments with the token gh already
    has and rewrites the report's local references to them; nothing is committed or
    pushed. Re-running replaces the previous report in the body.
    """
    post_status(json.loads(read_text(PACKET / "packet.json")), dry_run=args.dry_run)
    notes = []
    embed = gh_can_attach()
    if not embed:
        notes.append(f"media NOT attached: this gh has no --attach (needs 2.99 or newer). It is in {PLAY_OUT}; drag it into the PR.")
    path, files = build_report(embed)
    report = read_text(path)
    if args.dry_run:
        for note in notes:
            say(note)
        say(f"dry run: {len(files)} media file(s) would be attached; report at {path}; pull request not touched")
        return 0
    body = subprocess.run(["gh", "pr", "view", str(args.pr), "--json", "body", "-q", ".body"],
                          cwd=REPO, capture_output=True, text=True)
    if body.returncode:
        die(f"could not read pull request #{args.pr}: {body.stderr.strip()}")
    old = body.stdout.rstrip("\n")
    if START in old and END in old:
        new = old[: old.index(START)] + report.strip() + old[old.index(END) + len(END):]
    else:
        new = (old + "\n\n" if old else "") + report.strip()
    (OUT / "pr-body.md").write_text(new + "\n")
    # gh takes a limited number of files per command, so the media goes up in batches: each
    # command rewrites the references to its own files and leaves the rest for the next one.
    # Run from .gw so the references in the body and the --attach paths are the same strings.
    failed = False
    for start in range(0, max(len(files), 1), ATTACH_MAX_FILES):
        if start:
            current = subprocess.run(["gh", "pr", "view", str(args.pr), "--json", "body", "-q", ".body"],
                                     cwd=REPO, capture_output=True, text=True)
            if current.returncode:
                failed = True
                break
            (OUT / "pr-body.md").write_text(current.stdout)
        command = ["gh", "pr", "edit", str(args.pr), "--body-file", "pr-body.md"]
        for media in files[start:start + ATTACH_MAX_FILES]:
            command += ["--attach", media_ref(media)]
        if subprocess.run(command, cwd=OUT, stdout=subprocess.DEVNULL).returncode:
            failed = True
            break
    if failed:
        notes.append(f"gh could not finish updating the pull request; media that is missing from it is in {PLAY_OUT}")
    else:
        say(f"report written into the body of pull request #{args.pr}" + (f" with {len(files)} media file(s) attached" if files else ""))
    for note in notes:
        say(note)
    return 1 if (failed or notes) else 0


def cmd_finalize(args):
    """Headless gate, then a recorded playtest, then (with --pr) the report on the pull request."""
    load_claims(args)  # a bad claims file stops the run before the boots, not after them
    base = base_ref(args)
    if lint_gate(base):
        return 1
    if session_running():
        die("this checkout's play session is still running; `harness/gw session stop` first")
    code = cmd_headless(argparse.Namespace(map=args.map, timeout=180, only=None, compare=base, show=25))
    played = 0
    session = json.loads(read_text(SESSION) or "{}")
    holder = lock_holder()
    if session.get("by") == "person" and session.get("head") == git("rev-parse", "HEAD"):
        # A person's session at this commit is the playtest; an agent run would replace it.
        say(f"playtest: using the person's session {session.get('id')} with {len(load_marks())} mark(s)")
    elif args.skip_play:
        say("playtest skipped by --skip-play")
        rmtree(PLAY_OUT)
    elif not find_client():
        say("playtest NOT RUN: the Garry's Mod client is not installed (see `harness/gw doctor`)")
        rmtree(PLAY_OUT)
        played = 1
    elif holder and not args.wait:
        say(f"playtest NOT RUN: the game client is in use by {describe_holder(holder)}; `--wait` queues for it")
        rmtree(PLAY_OUT)
        played = 1
    else:
        start_session(argparse.Namespace(map=args.map, res="1280x720", fps=30, timeout=240, no_server=False,
                                         client_cmd=None, by="agent", streamed=False, wait=args.wait))
        try:
            played = cmd_playtest(args)
        finally:
            stop_session()
    cmd_packet(args)
    if args.pr:
        publish(args)
    else:
        if args.dry_run:
            post_status(json.loads(read_text(PACKET / "packet.json")), dry_run=True)
        say(f"report: {build_report()[0]}")
    return 1 if (code or played) else 0



