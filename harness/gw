def git(*args, check=True, **kwargs):
    done = subprocess.run(["git", "-C", str(REPO)] + list(args), capture_output=True, text=True, **kwargs)
    if check and done.returncode:
        die(f"git {' '.join(args)}: {done.stderr.strip()}")
    return done.stdout.strip()


def base_ref(args):
    if getattr(args, "base", None):
        return args.base
    if getattr(args, "pr", None):
        name = subprocess.run(["gh", "pr", "view", str(args.pr), "--json", "baseRefName", "-q", ".baseRefName"],
                              cwd=REPO, capture_output=True, text=True).stdout.strip()
        if name:
            return f"origin/{name}"
    return "origin/main"


CLAIMS = OUT / "claims.json"
CLAIM_KEYS, CLAIM_ID = {"title", "statement", "paths", "id"}, re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "claim"


def unique(name, used):
    """`name`, or `name-2`, `name-3`, ... whichever is not in `used` yet; added to it."""
    candidate, n = name, 1
    while candidate in used:
        n += 1
        candidate = f"{name}-{n}"
    used.add(candidate)
    return candidate


def load_claims(args):
    """The claims for this change: --claims, else .gw/claims.json, else --focus as one claim.

    Returns {"summary": str or None, "claims": [{id, title, statement, paths}]}. Ids are
    the explicit `id` where given and a slug of the title otherwise. A bad file stops the run.
    """
    path = Path(args.claims) if getattr(args, "claims", None) else (CLAIMS if CLAIMS.is_file() else None)
    focus = (getattr(args, "focus", None) or "").strip()
    if not path:
        if not focus:
            return {"summary": None, "claims": []}
        title = " ".join(re.split(r"[.;:!?\n]", focus, maxsplit=1)[0].split()[:5]).rstrip(",") or "Change"
        return {"summary": None, "claims": [{"id": slug(title), "title": title[0].upper() + title[1:],
                                             "statement": focus, "paths": []}]}

    def bad(message):
        die(f"{path}: {message}")

    try:
        data = json.loads(Path(path).read_text())
    except OSError as err:
        bad(f"cannot read it ({err.strerror})")
    except ValueError as err:
        bad(f"not valid JSON ({err})")
    if not isinstance(data, dict) or not isinstance(data.get("claims"), list):
        bad('expected an object with a "claims" list')
    if set(data) - {"summary", "claims"}:
        bad(f"unknown key(s) {', '.join(sorted(set(data) - {'summary', 'claims'}))}; only summary and claims")
    summary = data.get("summary")
    if summary is not None and not isinstance(summary, str):
        bad("summary must be a string")
    for n, claim in enumerate(data["claims"], 1):
        if not isinstance(claim, dict):
            bad(f"claim {n} is not an object")
        if set(claim) - CLAIM_KEYS:
            bad(f"claim {n}: unknown key(s) {', '.join(sorted(set(claim) - CLAIM_KEYS))}; allowed: {', '.join(sorted(CLAIM_KEYS))}")
        for key in ("title", "statement"):
            if not isinstance(claim.get(key), str) or not claim[key].strip():
                bad(f"claim {n}: {key} must be a non-empty string")
        paths = claim.get("paths", [])
        if not isinstance(paths, list) or not all(isinstance(p, str) and p.strip() and not p.startswith("/") for p in paths):
            bad(f"claim {n}: paths must be a list of repository-relative paths or globs")
        if "id" in claim and not (isinstance(claim["id"], str) and CLAIM_ID.match(claim["id"])):
            bad(f"claim {n}: id must be lowercase letters, digits and single hyphens")
    used, claims = set(), []
    for n, claim in enumerate(data["claims"], 1):
        if "id" in claim:
            if claim["id"] in used:
                bad(f"claim {n}: id {claim['id']} is used twice")
            used.add(claim["id"])
    for claim in data["claims"]:
        claims.append({"id": claim.get("id") or unique(slug(claim["title"]), used), "title": claim["title"].strip(),
                       "statement": claim["statement"].strip(), "paths": claim.get("paths", [])})
    return {"summary": (summary or "").strip() or focus or None, "claims": claims}


def change_brief(claims):
    """The "change under test" part of the playtest brief."""
    if not claims["claims"]:
        return ("No claims were given. Work out from the diff and commit messages what the change is meant to do, "
                "and treat each thing as a claim with a short title.")
    lines = [claims["summary"], ""] if claims["summary"] else []
    lines += [f"- `{c['id']}`: **{c['title']}**. {c['statement']}" for c in claims["claims"]]
    return "\n".join(lines)


def cmd_playtest(args):
    """Runs the playtest agent against the running session and saves its report."""
    if not session_alive():
        die("no play session is running; `harness/gw play start` first", 1)
    base = base_ref(args)
    prompt = (REPO / "harness/playtest.md").read_text().format(
        change=change_brief(load_claims(args)),
        base=base, minutes=args.minutes,
        stat=git("diff", "--stat", f"{base}...HEAD", check=False) or "(no committed changes against the base)",
    )
    report = PLAY_OUT / "playtest.md"
    argv = ["codex", "exec", "--model", args.model, "-c", f'model_reasoning_effort="{args.effort}"',
            "--sandbox", "workspace-write", "--cd", str(REPO), "--output-last-message", str(report), prompt]
    say(f"playtest by {args.model} ({args.effort}) for up to ~{args.minutes} min; transcript in {PLAY_OUT / 'playtest.log'}")
    with open(PLAY_OUT / "playtest.log", "wb") as log:
        try:
            code = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                                  timeout=args.minutes * 60 * 3 + 600).returncode
        except subprocess.TimeoutExpired:
            code = 124
    text = read_text(report)
    verdict = re.search(r"^VERDICT:\s*(pass|fail|blocked)", text, re.M | re.I)
    verdict = verdict.group(1).lower() if verdict else "blocked"
    if not text:
        report.write_text(f"VERDICT: blocked\n\nThe playtest agent produced no report (exit {code}).\n")
    (PLAY_OUT / "playtest.json").write_text(json.dumps(
        {"verdict": verdict, "model": args.model, "exit": code, "head": git("rev-parse", "--short", "HEAD"),
         **parse_playtest(read_text(report))}, indent=1))
    say(f"playtest verdict: {verdict}")
    return 0 if verdict == "pass" else 1


