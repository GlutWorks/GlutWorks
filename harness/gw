def find_client():
    """The installed Garry's Mod client, or None. GW_CLIENT_DIR overrides the search."""
    override = os.environ.get("GW_CLIENT_DIR")
    roots = [Path(override)] if override else []
    steam = Path.home() / ".local/share/Steam"
    libraries = re.findall(r'"path"\s+"([^"]+)"', read_text(steam / "steamapps/libraryfolders.vdf"))
    roots += [Path(lib) / "steamapps/common/GarrysMod" for lib in [str(steam)] + libraries]
    for root in roots:
        if (root / "garrysmod/gameinfo.txt").exists():
            return root
    return None


