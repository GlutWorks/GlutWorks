def parse_region(text):
    try:
        x, y, w, h = (float(part) for part in text.split(","))
    except ValueError:
        die("--region is x,y,w,h as fractions of the screen, for example 0.25,0.1,0.5,0.4", 2)
    if not (0 <= x < 1 and 0 <= y < 1 and 0 < w <= 1 - x + 1e-9 and 0 < h <= 1 - y + 1e-9):
        die("--region must lie inside the screen: 0 <= x, y < 1 and 0 < w <= 1 - x, 0 < h <= 1 - y", 2)
    return {"x": x, "y": y, "w": w, "h": h}


def cmd_mark(args):
    """Records a moment, or a range ending now or given in recording seconds, against the
    running session: one line appended to marks.jsonl, printed as JSON.

    The time is taken first, so the mark is where the caller was when it asked, however long
    the screenshot takes. Appends are serialised with flock, so any number of processes can
    mark one session at once.
    """
    marked = time.time()
    began = recording_began()
    alive = session_alive()
    if not alive and args.from_ is None:
        die("no play session is running; a stopped session's recording takes marks only with --from/--to", 1)
    if began is None:
        die("the session has not recorded a frame yet", 1)
    now_ms = round((marked - began) * 1000)
    entry = {"by": args.by or json.loads(read_text(SESSION) or "{}").get("by") or "agent", "note": args.note.strip()}
    if not entry["note"]:
        die("a mark needs a note", 2)
    if args.last is not None:
        if args.last <= 0:
            die("--last takes a number of seconds above 0", 2)
        entry.update(startMs=max(0, now_ms - round(args.last * 1000)), endMs=now_ms)
    elif args.to is not None and args.from_ is None:
        die("--to needs --from", 2)
    elif args.from_ is not None:
        if args.to is None or args.to <= args.from_ or args.from_ < 0:
            die("--from needs --to, with 0 <= from < to (seconds of the recording)", 2)
        if alive and args.to * 1000 > now_ms + 1000:
            die(f"--to {args.to} is in the future: the recording is at {now_ms / 1000:.1f}s", 2)
        entry.update(startMs=round(args.from_ * 1000), endMs=round(args.to * 1000))
    else:
        entry["atMs"] = now_ms
    if args.region:
        entry["region"] = parse_region(args.region)
    if args.claim:
        if not CLAIM_ID.match(args.claim):
            die("--claim takes a claim id: lowercase letters, digits and single hyphens", 2)
        entry["claim"] = args.claim

    PLAY_OUT.mkdir(parents=True, exist_ok=True)
    with open(MARKS, "a+") as marks:
        fcntl.flock(marks, fcntl.LOCK_EX)
        marks.seek(0)
        mark_id = f"m{sum(1 for line in marks if line.strip()) + 1}"
        entry = {"id": mark_id, "session": json.loads(read_text(SESSION) or "{}").get("id"), **entry,
                 "createdAt": now_iso()}
        if args.shot:
            if not alive:
                die("--shot needs the session running", 1)
            shot = take_shot(f"mark-{mark_id}")
            if shot:
                entry["shot"] = str(shot.relative_to(PLAY_OUT))
            else:
                say("warning: the screenshot was not produced; the mark is recorded without it")
        marks.write(json.dumps(entry, ensure_ascii=False) + "\n")
    emit(dict(entry, file=str(MARKS)))
    return 0



