def need_install():
    if not (DS / "bin/linux64/srcds").exists():
        die(f"dedicated server not installed at {DS}; run `harness/gw setup`")
    if not shutil.which("bwrap"):
        die("bubblewrap (bwrap) is required")


def cmd_setup(args):
    STEAMCMD.mkdir(parents=True, exist_ok=True)
    if not (STEAMCMD / "steamcmd.sh").exists():
        say("downloading SteamCMD")
        subprocess.run(
            "curl -fsSL https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz | tar xz",
            shell=True, cwd=STEAMCMD, check=True)
    say(f"installing/updating Garry's Mod dedicated server (x86-64 branch) into {DS}")
    subprocess.run([str(STEAMCMD / "steamcmd.sh"), "+force_install_dir", str(DS), "+login", "anonymous",
                    "+app_update", "4020", "-beta", "x86-64", "validate", "+quit"], check=True)
    install_tools()
    if not install_glualint():
        say(f"could not fetch glualint {GLUALINT_VERSION}; `harness/gw lint` will try again on first use")
    install_compat()
    install_addons()
    return cmd_doctor(args)


def client_is_64bit(client):
    return (client / "bin/linux64/gmod").exists()


def compat_dir(client):
    return HOME / ("compat64" if client_is_64bit(client) else "compat32")


def install_compat():
    """Collects the few libraries the game client needs that this system lacks.

    The client links against libraries from Steam's old "scout" runtime (OpenSSL 1.0 for
    the 64-bit branch, GTK2-era ones for the 32-bit branch). Only the libraries the loader
    cannot find are copied, from the scout runtime Steam already installed, so the
    system's own graphics stack stays in use.
    """
    client = find_client()
    scout = Path.home() / ".local/share/Steam/steamapps/common/SteamLinuxRuntime/steam-runtime"
    if not client or not scout.is_dir():
        return
    if client_is_64bit(client):
        triplet, binaries = "x86_64-linux-gnu", client / "bin/linux64"
        targets = [binaries / "gmod"] + sorted(binaries.glob("*.so"))
        sources = [scout / "amd64/usr/lib" / triplet, scout / "amd64/lib" / triplet, scout / "amd64/usr/lib"]
    else:
        triplet, binaries = "i386-linux-gnu", client / "bin"
        targets = [client / "hl2_linux"] + sorted(binaries.glob("*.so")) + sorted((client / "garrysmod/bin").glob("*.so"))
        sources = [scout / "i386/usr/lib" / triplet, scout / "i386/lib" / triplet, scout / "i386/usr/lib"]
    compat = compat_dir(client)
    compat.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ, LD_LIBRARY_PATH=f"{binaries}:{compat}")
    copied = 0
    while True:
        missing = set()
        for target in targets + sorted(compat.iterdir()):
            out = subprocess.run(["ldd", str(target)], capture_output=True, text=True, env=env).stdout
            missing.update(re.findall(r"^\s*(\S+) => not found", out, re.M))
        found = False
        for name in sorted(missing):
            for source in sources:
                if (source / name).exists() and not (compat / name).exists():
                    shutil.copy((source / name).resolve(), compat / name)
                    copied += 1
                    found = True
                    break
        if not found:
            break
    if copied:
        say(f"copied {copied} libraries for the game client into {compat}")
    if missing:
        say(f"still unresolved for the game client: {', '.join(sorted(missing))}")


def install_addons():
    """Downloads and unpacks every Workshop addon in the manifest that is not cached yet."""
    missing = [(workshop_id, path) for workshop_id, path in addons() if not path.is_dir()]
    if not missing:
        return
    # SteamCMD gets its own HOME so it cannot write into the user's Steam library.
    home = STEAMCMD / "home"
    home.mkdir(exist_ok=True)
    env = dict(os.environ, HOME=str(home))
    gmad = DS / "bin/linux64/gmad"
    for workshop_id, path in missing:
        say(f"downloading Workshop addon {workshop_id}")
        subprocess.run([str(STEAMCMD / "steamcmd.sh"), "+login", "anonymous", "+workshop_download_item", "4000",
                        workshop_id, "+quit"], env=env, stdout=subprocess.DEVNULL, check=False)
        files = [f for f in STEAMCMD.glob(f"**/workshop/content/4000/{workshop_id}/*") if f.is_file()]
        if not files:
            say(f"  could not download {workshop_id}; it may need a signed-in account or be gone from the Workshop")
            continue
        archive = files[0]
        if archive.suffix != ".gma":  # older uploads are LZMA-compressed
            unpacked = ADDONS / f"{workshop_id}.gma"
            ADDONS.mkdir(parents=True, exist_ok=True)
            with open(unpacked, "wb") as out:
                subprocess.run(["xz", "--format=lzma", "-dc", str(archive)], stdout=out, check=False)
            archive = unpacked
        subprocess.run([str(gmad), "extract", "-file", str(archive), "-out", str(path)], cwd=DS,
                       env=dict(os.environ, LD_LIBRARY_PATH=str(DS / "bin/linux64")), stdout=subprocess.DEVNULL, check=False)
        (ADDONS / f"{workshop_id}.gma").unlink(missing_ok=True)
        if not path.is_dir():
            say(f"  could not unpack {workshop_id}")


def install_tools():
    """Unpacks the compositor and capture tools into a private prefix; nothing is installed system-wide."""
    if (TOOLS / "usr/bin/sway").exists():
        return
    say(f"fetching sway, wf-recorder and grim into {TOOLS}")
    (TOOLS / "pkg").mkdir(parents=True, exist_ok=True)
    urls = subprocess.run(["pacman", "-Sp", "sway", "wf-recorder", "grim"], capture_output=True, text=True, check=True)
    for url in urls.stdout.split():
        if "wayland-protocols" in url:
            continue
        archive = TOOLS / "pkg" / url.rsplit("/", 1)[1]
        if not archive.exists():
            subprocess.run(["curl", "-fsSL", "-o", str(archive), url], check=True)
        subprocess.run(["bsdtar", "-xf", str(archive), "-C", str(TOOLS), "usr"], check=True)


def cmd_doctor(_args):
    rows = [
        ("dedicated server", (DS / "bin/linux64/srcds").exists(), str(DS), "harness/gw setup"),
        ("bubblewrap", bool(shutil.which("bwrap")), "sandbox", "pacman -S bubblewrap"),
        ("ffmpeg", bool(shutil.which("ffmpeg")), "video encoding", "pacman -S ffmpeg"),
        ("session tools", (TOOLS / "usr/bin/sway").exists(), "sway, wf-recorder, grim in a private prefix", "harness/gw setup"),
        ("game client", bool(find_client()), str(find_client() or "needed for play sessions only"),
         "install Garry's Mod (app 4000) through Steam"),
        ("codex", bool(shutil.which("codex")), "runs the playtest agent", "install the Codex CLI"),
        ("glualint", GLUALINT.exists(), f"{GLUALINT_VERSION} for `gw lint`", "harness/gw setup (or `gw lint` fetches it)"),
        ("workshop addons", all(path.is_dir() for _, path in addons()),
         f"{sum(path.is_dir() for _, path in addons())} of {len(addons())} in the manifest are cached", "harness/gw setup"),
    ]
    ok = True
    for name, present, what, fix in rows:
        say(f"  {'ok     ' if present else 'MISSING'} {name:18} {what}" + ("" if present else f"  -> {fix}"))
        ok = ok and present
    say(f"run id {RUN_ID}; run state in {RUN}; artifacts in {OUT}")
    return 0 if ok else 1


def main():
    parser = argparse.ArgumentParser(prog="gw", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("setup", help="install or update the dedicated server").set_defaults(fn=cmd_setup)
    sub.add_parser("doctor", help="report what is installed").set_defaults(fn=cmd_doctor)

    p = sub.add_parser("headless", help="boot the server in the sandbox and run the checks")
    p.add_argument("--map", default="gm_construct")
    p.add_argument("--timeout", type=int, default=180)
    p.add_argument("--only", help="run only checks whose name contains this")
    p.add_argument("--compare", metavar="REF", help="also run the merge-base with REF and fail only on new failures")
    p.add_argument("--show", type=int, default=25, help="failures to print")
    p.set_defaults(fn=cmd_headless)

    p = sub.add_parser("lint", help="glualint on the changed .lua files, plus docs freshness (under a second)")
    p.add_argument("paths", nargs="*", help="lint these files or directories instead (helix/ only this way)")
    p.add_argument("--all", action="store_true", help="every tracked .lua file under ixhl2rp/ and harness/")
    p.add_argument("--base", default="origin/main", help="ref whose merge-base the changes are taken against")
    p.add_argument("--all-warnings", action="store_true", help="show warnings on unchanged lines too")
    p.set_defaults(fn=cmd_lint)

    p = sub.add_parser("dump", help="the resolved registry (items, recipes, commands, ...) as .gw/registry.json")
    p.add_argument("section", nargs="?", help="list the IDs in this section")
    p.add_argument("id", nargs="?", help="print this entry of the section")
    p.add_argument("--fresh", action="store_true", help="boot even if the cached registry is current")
    p.add_argument("--addons", action="store_true", help="mount the Workshop content (slower; see README)")
    p.add_argument("--map", default="gm_construct")
    p.add_argument("--timeout", type=int, default=180)
    p.set_defaults(fn=cmd_dump)

    play = sub.add_parser("play", help="drive a recorded client session in an isolated Wayland session")
    psub = play.add_subparsers(dest="play_cmd", required=True)
    p = psub.add_parser("start", help="start compositor, server, recorder and client")
    p.add_argument("--map", default="gm_construct")
    p.add_argument("--res", default="1280x720")
    p.add_argument("--fps", type=int, default=30)
    p.add_argument("--timeout", type=int, default=240)
    p.add_argument("--no-server", action="store_true")
    p.add_argument("--client-cmd", help="run this instead of the game client (for testing the session itself)")
    p.set_defaults(fn=cmd_play_start)
    psub.add_parser("stop", help="stop the session and encode the recording").set_defaults(fn=cmd_play_stop)
    psub.add_parser("status").set_defaults(fn=cmd_play_status)
    p = psub.add_parser("shot", help="save a screenshot of the session")
    p.add_argument("name")
    p.set_defaults(fn=cmd_play_shot)
    p = psub.add_parser("type", help="type TEXT into the focused field with real key events")
    p.add_argument("text")
    p.add_argument("--enter", action="store_true", help="press Return afterwards")
    p.add_argument("--replace", action="store_true", help="clear the field first")
    p.set_defaults(fn=cmd_play_type)
    p = psub.add_parser("xdo", help="real input via xdotool: xdo key Return | xdo mousemove 640 360 click 1 | xdo type hello")
    p.add_argument("rest", nargs=argparse.REMAINDER)
    p.set_defaults(fn=cmd_play_xdo)
    for op, text in [("state", "player, character, inventory and surroundings as JSON"),
                     ("panels", "visible UI panels with click coordinates"),
                     ("errors", "Lua errors since the last call, both realms"),
                     ("checks", "run the headless checks inside the live session"),
                     ("sv", "run Lua on the server: sv '<code>'"), ("cl", "run Lua on the client: cl '<code>'"),
                     ("con", "run a client console command: con say /help"),
                     ("click", "click the panel at X Y [right]"), ("press", "click the panel showing TEXT [right]"),
                     ("choose", "aim at the row of the open world panel labelled TEXT and choose it"),
                     ("key", "press KEY_* [seconds]"),
                     ("look", "look '{\"yaw\":90,\"pitch\":0}' or '{\"ent\":123}'"),
                     ("move", "move '{\"forward\":1,\"seconds\":2,\"buttons\":[\"IN_USE\"]}'")]:
        p = psub.add_parser(op, help=text)
        p.add_argument("rest", nargs=argparse.REMAINDER)
        p.set_defaults(fn=cmd_play_rpc, op=op)

    def playtest_options(p):
        p.add_argument("--focus", help="what the change is meant to do, in a sentence or two")
        p.add_argument("--base", help="ref the change is compared against (default: the PR base, else origin/main)")
        p.add_argument("--pr", type=int, help="pull request number")
        p.add_argument("--model", default="gpt-6.1-terra")
        p.add_argument("--effort", default="medium")
        p.add_argument("--minutes", type=int, default=10)

    p = sub.add_parser("playtest", help="have the playtest agent drive the running session")
    playtest_options(p)
    p.set_defaults(fn=cmd_playtest)

    sub.add_parser("report", help="assemble .gw/report.md from the stages that ran").set_defaults(fn=cmd_report)

    p = sub.add_parser("publish", help="write the report into the PR body with the media attached")
    p.add_argument("--pr", type=int, required=True)
    p.add_argument("--dry-run", action="store_true", help="build the report but upload and edit nothing")
    p.set_defaults(fn=cmd_publish)

    p = sub.add_parser("finalize", help="headless gate + recorded playtest + report; the one command for a PR")
    playtest_options(p)
    p.add_argument("--map", default="gm_construct")
    p.add_argument("--skip-play", action="store_true", help="headless stage only")
    p.add_argument("--dry-run", action="store_true", help="with --pr: build the report, upload and edit nothing")
    p.set_defaults(fn=cmd_finalize)

    args = parser.parse_args()
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
