def git(*args, check=True, **kwargs):
    done = subprocess.run(["git", "-C", str(REPO)] + list(args), capture_output=True, text=True, **kwargs)
    if check and done.returncode:
        die(f"git {' '.join(args)}: {done.stderr.strip()}")
    return done.stdout.strip()


def base_ref(args):
    if getattr(args, "base", None):
        return args.base
    if getattr(args, "pr", None):
        name = subprocess.run(["gh", "pr", "view", str(args.pr), "--json", "baseRefName", "-q", ".baseRefName"],
                              cwd=REPO, capture_output=True, text=True).stdout.strip()
        if name:
            return f"origin/{name}"
    return "origin/main"


def cmd_playtest(args):
    """Runs the playtest agent against the running session and saves its report."""
    if not session_alive():
        die("no play session is running; `harness/gw play start` first", 1)
    base = base_ref(args)
    prompt = (REPO / "harness/playtest.md").read_text().format(
        focus=args.focus or "No description was given; infer the intent from the diff and commit messages.",
        base=base, minutes=args.minutes,
        stat=git("diff", "--stat", f"{base}...HEAD", check=False) or "(no committed changes against the base)",
    )
    report = PLAY_OUT / "playtest.md"
    argv = ["codex", "exec", "--model", args.model, "-c", f'model_reasoning_effort="{args.effort}"',
            "--sandbox", "workspace-write", "--cd", str(REPO), "--output-last-message", str(report), prompt]
    say(f"playtest by {args.model} ({args.effort}) for up to ~{args.minutes} min; transcript in {PLAY_OUT / 'playtest.log'}")
    with open(PLAY_OUT / "playtest.log", "wb") as log:
        try:
            code = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                                  timeout=args.minutes * 60 * 3 + 600).returncode
        except subprocess.TimeoutExpired:
            code = 124
    text = read_text(report)
    verdict = re.search(r"^VERDICT:\s*(pass|fail|blocked)", text, re.M | re.I)
    verdict = verdict.group(1).lower() if verdict else "blocked"
    if not text:
        report.write_text(f"VERDICT: blocked\n\nThe playtest agent produced no report (exit {code}).\n")
    (PLAY_OUT / "playtest.json").write_text(json.dumps(
        {"verdict": verdict, "model": args.model, "exit": code, "head": git("rev-parse", "--short", "HEAD"),
         **parse_playtest(read_text(report))}, indent=1))
    say(f"playtest verdict: {verdict}")
    return 0 if verdict == "pass" else 1


START, END = "<!-- gw-finalize:start -->", "<!-- gw-finalize:end -->"
ATTACH_MAX_FILES = 50    # per gh command
HIGHLIGHT_MAX = 8        # things shown on the pull request
CLIP_SECONDS = 10        # the longest one highlight runs in the reel; longer spans are sped up
CLIP_MARGIN = 1.5        # seconds kept before the first and after the last screenshot of a clip


def media_ref(path):
    """How the report and `gh --attach` both name a media file: its path relative to .gw."""
    return "./" + str(path.relative_to(OUT))


def gh_can_attach():
    return "--attach" in subprocess.run(["gh", "pr", "edit", "--help"], capture_output=True, text=True).stdout


def parse_playtest(text):
    """The HIGHLIGHT, BLOCKER and NOTE lines of the playtest agent's report (see playtest.md)."""
    highlights = []
    for title, sentence, media in re.findall(
            r"^[ \t]*(?:[-*][ \t]*)?HIGHLIGHT:[ \t]*(.+?)[ \t]*\|[ \t]*(.+?)[ \t]*\|[ \t]*`?([^\s`|]+)`?[ \t]*$", text, re.M):
        first, _, last = media.replace(".jpg", "").partition("..")
        highlights.append({"title": title.strip("*` "), "text": sentence, "from": first, "to": last or first})
    def lines(kind):
        return re.findall(rf"^[ \t]*(?:[-*][ \t]*)?{kind}:[ \t]*(.+?)[ \t]*$", text, re.M)

    return {"highlights": highlights[:HIGHLIGHT_MAX], "blockers": lines("BLOCKER"), "notes": lines("NOTE")}


def find_shot(name):
    """A screenshot by the name the agent gave it, with or without its counter prefix."""
    shots = PLAY_OUT / "shots"
    if (shots / f"{name}.jpg").exists():
        return shots / f"{name}.jpg"
    return next(iter(sorted(shots.glob(f"*_{name}.jpg"))), None)


def build_reel(highlights):
    """Joins a short captioned clip for every highlight that spans two screenshots into
    reel.mp4, cut from the session recording. Returns the reel, or None without clips.

    A screenshot's place in the recording is its file time measured from the recording's
    start; a span longer than CLIP_SECONDS is sped up to fit.
    """
    raw, reel, clips = PLAY_OUT / "session.mkv", PLAY_OUT / "reel.mp4", PLAY_OUT / "clips"
    reel.unlink(missing_ok=True)
    rmtree(clips)
    length = media_seconds(raw) if raw.exists() else 0.0
    if not length:
        return None
    began = raw.stat().st_mtime - length  # the recorder writes until the session stops
    clips.mkdir()
    parts = []
    for index, item in enumerate(highlights):
        first, last = find_shot(item["from"]), find_shot(item["to"])
        if not first or not last or first == last:
            continue
        start = max(first.stat().st_mtime - began - CLIP_MARGIN, 0.0)
        span = min(last.stat().st_mtime - began + CLIP_MARGIN, length) - start
        if span < 1:
            continue
        speed = max(1.0, span / CLIP_SECONDS)
        caption = clips / f"{index}.txt"
        caption.write_text(item["title"] + (f"  ({speed:.0f}x)" if speed >= 1.5 else ""))
        part = clips / f"{index}.mp4"
        subprocess.run(
            ["ffmpeg", "-y", "-loglevel", "error", "-ss", f"{start:.2f}", "-t", f"{span:.2f}", "-i", str(raw), "-vf",
             f"setpts=PTS/{speed:.3f},fps=20,scale=960:-2,drawtext=textfile={caption}:x=24:y=h-th-24:fontsize=28:"
             "fontcolor=white:box=1:boxcolor=black@0.6:boxborderw=12",
             "-c:v", "libx264", "-preset", "medium", "-crf", "27", "-pix_fmt", "yuv420p", "-an", str(part)],
            stderr=subprocess.DEVNULL, check=False)
        if part.exists() and part.stat().st_size:
            parts.append(part)
    if not parts:
        return None
    (clips / "list.txt").write_text("".join(f"file '{part}'\n" for part in parts))
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-f", "concat", "-safe", "0", "-i", str(clips / "list.txt"),
                    "-c", "copy", "-movflags", "+faststart", str(reel)], stderr=subprocess.DEVNULL, check=False)
    if not reel.exists() or not 0 < reel.stat().st_size <= ATTACH_LIMIT:
        reel.unlink(missing_ok=True)
        return None
    return reel


def build_report(embed=True):
    """Assembles the Markdown that goes into the pull request from whatever stages ran.

    It is deliberately short: one status line, one short video, and one screenshot per
    thing the playtest saw working. The full check list and the playtest agent's whole
    report stay in .gw. Media is referenced by its path relative to .gw, which
    `gh --attach` rewrites to the uploaded asset; with embed off it is left out.
    Returns the report and the media files it references.
    """
    media = []

    def ref(path):
        media.append(path)
        return media_ref(path)

    verdict = json.loads(read_text(OUT / "headless/verdict.json") or "{}")
    result = json.loads(read_text(OUT / "headless/result.json") or "{}")
    if verdict:
        passed = sum(1 for check in result.get("checks", []) if check.get("ok"))
        checks = (f"{passed} pass, no new failures" if verdict["pass"] else f"**{len(verdict['new'])} new failure(s)**")
    else:
        checks = "not run"
    play = json.loads(read_text(PLAY_OUT / "playtest.json") or "{}")
    played = f"playtest by {play['model']}: **{play['verdict']}**" if play else "playtest: not run"
    head = play.get("head") or git("rev-parse", "--short", "HEAD")  # the commit that was played, if one was
    lines = [START, f"**Tested at `{head}`** · server checks: {checks} · {played}", ""]
    for failure in (verdict.get("new") or [])[:10]:
        lines.append(f"- new failure: `{failure}`")
    if verdict.get("new"):
        lines.append("")

    if play:
        highlights = play.get("highlights") or []
        reel = build_reel(highlights) if embed else None
        whole = PLAY_OUT / "session.mp4"
        if reel:
            lines += [f"![]({ref(reel)})", ""]  # alone in its paragraph, so it renders as a player
        elif embed and whole.exists() and whole.stat().st_size <= ATTACH_LIMIT:
            speed = float(read_text(PLAY_OUT / "speed.txt") or 1)
            lines += [f"The whole session{f', sped up {speed:.0f}x' if speed > 1 else ''}:", "", f"![]({ref(whole)})", ""]

        def cell(text):
            return text.replace("|", "\\|").replace("\n", " ")

        for start in range(0, len(highlights), 2):
            pair = highlights[start:start + 2]
            shots = [find_shot(item["to"]) if embed else None for item in pair]
            lines += ["| " + " | ".join(cell(item["title"]) for item in pair) + " |",
                      "|" + "---|" * len(pair)]
            if any(shots):
                lines.append("| " + " | ".join(f"![{cell(item['title'])}]({ref(shot)})" if shot else ""
                                               for item, shot in zip(pair, shots)) + " |")
            lines += ["| " + " | ".join(cell(item["text"]) for item in pair) + " |", ""]
        if not highlights:
            lines += ["_The playtest named no highlights; its report is in `.gw/play/playtest.md`._", ""]

        # Blockers are the playtest's only findings that count against the change. Notes are
        # the playtester's suggestions; whether to act on them is the author's call.
        blockers, notes = play.get("blockers") or [], play.get("notes") or []
        if blockers:
            lines += [f"**Blocking:** {blocker}" for blocker in blockers] + [""]
        if notes:
            lines += [f"<details><summary>{len(notes)} playtester note(s): suggestions, not requirements</summary>", ""]
            lines += [f"- {note}" for note in notes] + ["", "</details>", ""]
        errors = json.loads(read_text(PLAY_OUT / "server-errors.json") or "[]")
        if errors:
            lines += [f"<details><summary>{len(errors)} error(s) in the game console during play</summary>", "", "```"]
            lines += errors[:20] + ["```", "", "</details>", ""]
    lines.append(END)
    (OUT / "report.md").write_text("\n".join(lines) + "\n")
    return OUT / "report.md", media


def cmd_report(_args):
    print(build_report()[0])
    return 0


def cmd_publish(args):
    """Writes the report into the pull request body, with its media attached to the PR.

    `gh pr edit --attach` uploads the media as GitHub attachments with the token gh already
    has and rewrites the report's local references to them; nothing is committed or
    pushed. Re-running replaces the previous report in the body.
    """
    notes = []
    embed = gh_can_attach()
    if not embed:
        notes.append(f"media NOT attached: this gh has no --attach (needs 2.99 or newer). It is in {PLAY_OUT}; drag it into the PR.")
    path, files = build_report(embed)
    report = read_text(path)
    if args.dry_run:
        for note in notes:
            say(note)
        say(f"dry run: {len(files)} media file(s) would be attached; report at {path}; pull request not touched")
        return 0
    body = subprocess.run(["gh", "pr", "view", str(args.pr), "--json", "body", "-q", ".body"],
                          cwd=REPO, capture_output=True, text=True)
    if body.returncode:
        die(f"could not read pull request #{args.pr}: {body.stderr.strip()}")
    old = body.stdout.rstrip("\n")
    if START in old and END in old:
        new = old[: old.index(START)] + report.strip() + old[old.index(END) + len(END):]
    else:
        new = (old + "\n\n" if old else "") + report.strip()
    (OUT / "pr-body.md").write_text(new + "\n")
    # gh takes a limited number of files per command, so the media goes up in batches: each
    # command rewrites the references to its own files and leaves the rest for the next one.
    # Run from .gw so the references in the body and the --attach paths are the same strings.
    failed = False
    for start in range(0, max(len(files), 1), ATTACH_MAX_FILES):
        if start:
            current = subprocess.run(["gh", "pr", "view", str(args.pr), "--json", "body", "-q", ".body"],
                                     cwd=REPO, capture_output=True, text=True)
            if current.returncode:
                failed = True
                break
            (OUT / "pr-body.md").write_text(current.stdout)
        command = ["gh", "pr", "edit", str(args.pr), "--body-file", "pr-body.md"]
        for media in files[start:start + ATTACH_MAX_FILES]:
            command += ["--attach", media_ref(media)]
        if subprocess.run(command, cwd=OUT, stdout=subprocess.DEVNULL).returncode:
            failed = True
            break
    if failed:
        notes.append(f"gh could not finish updating the pull request; media that is missing from it is in {PLAY_OUT}")
    else:
        say(f"report written into the body of pull request #{args.pr}" + (f" with {len(files)} media file(s) attached" if files else ""))
    for note in notes:
        say(note)
    return 1 if (failed or notes) else 0


def cmd_finalize(args):
    """Headless gate, then a recorded playtest, then (with --pr) the report on the pull request."""
    base = base_ref(args)
    if lint_gate(base):
        return 1
    code = cmd_headless(argparse.Namespace(map=args.map, timeout=180, only=None, compare=base, show=25))
    played = 0
    if args.skip_play:
        say("playtest skipped by --skip-play")
        rmtree(PLAY_OUT)
    elif not find_client():
        say("playtest NOT RUN: the Garry's Mod client is not installed (see `harness/gw doctor`)")
        rmtree(PLAY_OUT)
        played = 1
    else:
        cmd_play_start(argparse.Namespace(map=args.map, res="1280x720", fps=30, timeout=240, no_server=False, client_cmd=None))
        try:
            played = cmd_playtest(args)
        finally:
            cmd_play_stop(args)
    if args.pr:
        cmd_publish(argparse.Namespace(pr=args.pr, dry_run=args.dry_run))
    else:
        say(f"report: {build_report()[0]}")
    return 1 if (code or played) else 0



