    """True while the session loop is beating. Works from inside another sandbox, where
    the session's process cannot be seen or signalled."""
    try:
        return time.time() - (PLAY_OUT / "alive").stat().st_mtime < 5 and not (PLAY_OUT / "stop").exists()
