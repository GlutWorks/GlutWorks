def git(*args, check=True, **kwargs):
    done = subprocess.run(["git", "-C", str(REPO)] + list(args), capture_output=True, text=True, **kwargs)
    if check and done.returncode:
        die(f"git {' '.join(args)}: {done.stderr.strip()}")
    return done.stdout.strip()


def base_ref(args):
    if getattr(args, "base", None):
        return args.base
    if getattr(args, "pr", None):
        name = subprocess.run(["gh", "pr", "view", str(args.pr), "--json", "baseRefName", "-q", ".baseRefName"],
                              cwd=REPO, capture_output=True, text=True).stdout.strip()
        if name:
            return f"origin/{name}"
    return "origin/main"


def cmd_playtest(args):
    """Runs the playtest agent against the running session and saves its report."""
    if not session_alive():
        die("no play session is running; `harness/gw play start` first", 1)
    base = base_ref(args)
    prompt = (REPO / "harness/playtest.md").read_text().format(
        focus=args.focus or "No description was given; infer the intent from the diff and commit messages.",
        base=base, minutes=args.minutes,
        stat=git("diff", "--stat", f"{base}...HEAD", check=False) or "(no committed changes against the base)",
    )
    report = PLAY_OUT / "playtest.md"
    argv = ["codex", "exec", "--model", args.model, "-c", f'model_reasoning_effort="{args.effort}"',
            "--sandbox", "workspace-write", "--cd", str(REPO), "--output-last-message", str(report), prompt]
    say(f"playtest by {args.model} ({args.effort}) for up to ~{args.minutes} min; transcript in {PLAY_OUT / 'playtest.log'}")
    with open(PLAY_OUT / "playtest.log", "wb") as log:
        try:
            code = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                                  timeout=args.minutes * 60 * 3 + 600).returncode
        except subprocess.TimeoutExpired:
            code = 124
    text = read_text(report)
    verdict = re.search(r"^VERDICT:\s*(pass|fail|blocked)", text, re.M | re.I)
    verdict = verdict.group(1).lower() if verdict else "blocked"
    if not text:
        report.write_text(f"VERDICT: blocked\n\nThe playtest agent produced no report (exit {code}).\n")
    (PLAY_OUT / "playtest.json").write_text(json.dumps({"verdict": verdict, "model": args.model, "exit": code}))
    say(f"playtest verdict: {verdict}")
    return 0 if verdict == "pass" else 1


START, END = "<!-- gw-finalize:start -->", "<!-- gw-finalize:end -->"
SESSION_FILE = Path(os.environ.get("GW_GITHUB_SESSION_FILE", Path.home() / ".config/gw-harness/github-session"))


def build_report(urls=None):
    """Assembles the Markdown that goes into the pull request from whatever stages ran.

    `urls` maps a media file's path relative to .gw/play to its attachment URL. Media
    without a URL is named but not embedded.
    """
    urls = urls or {}
    head = git("rev-parse", "--short", "HEAD")
    lines = [START, f"## Finalization run for `{head}`", ""]
    verdict = json.loads(read_text(OUT / "headless/verdict.json") or "{}")
    if verdict:
        status = "pass" if verdict["pass"] else f"**fail: {len(verdict['new'])} new failure(s)**"
        lines += [f"**Headless server run:** {status}"
                  + (f", {len(verdict['fixed'])} fixed, {len(verdict['known'])} already failing on base"
                     if verdict["fixed"] or verdict["known"] else ""), ""]
        for failure in verdict["new"][:30]:
            lines.append(f"- new: `{failure}`")
        for failure in verdict["fixed"][:30]:
            lines.append(f"- fixed: `{failure}`")
        lines += ["", "<details><summary>Checks</summary>", "",
                  read_text(OUT / "headless/summary.md").split("\n", 2)[-1].strip(), "", "</details>", ""]
    else:
        lines += ["**Headless server run:** not run", ""]

    play = json.loads(read_text(PLAY_OUT / "playtest.json") or "{}")
    if play:
        lines += [f"**Playtest ({play['model']}):** {play['verdict']}", ""]
        if "session.mp4" in urls:
            speed = float(read_text(PLAY_OUT / "speed.txt") or 1)
            if speed > 1:
                lines += [f"Recording of the session, sped up {speed:.1f}x:", ""]
            lines += [urls["session.mp4"], ""]  # a bare attachment URL on its own line renders as a player
        lines += ["<details><summary>Playtest report</summary>", "", read_text(PLAY_OUT / "playtest.md").strip(), "", "</details>", ""]
        shots = sorted((PLAY_OUT / "shots").glob("*.jpg"))
        embedded = [shot for shot in shots if f"shots/{shot.name}" in urls]
        if embedded:
            lines += ["<details><summary>Screenshots</summary>", ""]
            for shot in embedded:
                lines += [f"**{shot.stem}**", "", f"![{shot.stem}]({urls['shots/' + shot.name]})", ""]
            lines += ["</details>", ""]
        missing = len(shots) - len(embedded) + (1 if (PLAY_OUT / "session.mp4").exists() and "session.mp4" not in urls else 0)
        if missing:
            lines += [f"_{missing} media file(s) from this run were not attached; see the note from `harness/gw publish`._", ""]
        errors = json.loads(read_text(PLAY_OUT / "server-errors.json") or "[]")
        if errors:
            lines += [f"<details><summary>{len(errors)} error(s) in the game console during play</summary>", "", "```"]
            lines += errors[:40] + ["```", "", "</details>", ""]
    else:
        lines += ["**Playtest:** not run", ""]
    lines.append(END)
    (OUT / "report.md").write_text("\n".join(lines) + "\n")
    return OUT / "report.md"


def cmd_report(_args):
    print(build_report())
    return 0


class UploadError(Exception):
    pass


def curl_json(args, what):
    done = subprocess.run(["curl", "-sS", "--fail-with-body"] + args, capture_output=True, text=True)
    if done.returncode:
        raise UploadError(f"{what} failed: {(done.stdout or done.stderr).strip()[:300]}")
    try:
        return json.loads(done.stdout) if done.stdout.strip() else {}
    except ValueError:
        raise UploadError(f"{what} did not return JSON; the web session is probably expired")


def attach(path, slug, pr, repo_id, session):
    """Uploads one file as a GitHub attachment, the way dragging it into a comment box does.

    GitHub has no token API for attachments; they are tied to a signed-in web session, so
    this needs the `user_session` cookie. Returns the user-attachments URL.
    """
    page = f"https://github.com/{slug}/pull/{pr}"
    browser = ["-H", f"Cookie: user_session={session}; __Host-user_session_same_site={session}; logged_in=yes",
               "-H", "Origin: https://github.com", "-H", f"Referer: {page}", "-H", "Accept: application/json",
               "-H", "X-Requested-With: XMLHttpRequest", "-H", "GitHub-Verified-Fetch: true"]
    html = subprocess.run(["curl", "-sS", "-L", "-H", browser[1], page], capture_output=True, text=True).stdout
    tag = re.search(r"<input[^>]*js-data-upload-policy-url-csrf[^>]*>", html)
    token = re.search(r'value="([^"]+)"', tag.group(0)).group(1) if tag else ""
    content_type = {".mp4": "video/mp4", ".jpg": "image/jpeg", ".png": "image/png", ".gif": "image/gif"}[path.suffix]

    policy = curl_json(browser + ["-X", "POST", "https://github.com/upload/policies/assets",
                                  "--form-string", f"name={path.name}", "--form-string", f"size={path.stat().st_size}",
                                  "--form-string", f"content_type={content_type}", "--form-string", f"repository_id={repo_id}",
                                  "--form-string", f"authenticity_token={token}"], "requesting an upload slot")
    form = []
    for key, value in policy["form"].items():
        form += ["--form-string", f"{key}={value}"]
    stored = subprocess.run(["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}", "-X", "POST", policy["upload_url"]]
                            + form + ["-F", f"file=@{path};type={content_type}"], capture_output=True, text=True)
    if not stored.stdout.startswith("2"):
        raise UploadError(f"storing {path.name} failed with HTTP {stored.stdout}")
    confirm = policy.get("asset_upload_url")
    if confirm:
        curl_json(browser + ["-X", "PUT", "https://github.com" + confirm, "--form-string",
                             f"authenticity_token={policy.get('asset_upload_authenticity_token', '')}"], "confirming the upload")
    return policy["asset"]["href"]


def cmd_publish(args):
    """Writes the report into the pull request body, with the media attached to the PR.

    Media is uploaded as GitHub attachments and referenced from the body; nothing is
    committed or pushed. Re-running replaces the previous report in the body.
    """
    files = [PLAY_OUT / "session.mp4"] if (PLAY_OUT / "session.mp4").exists() else []
    files += sorted((PLAY_OUT / "shots").glob("*.jpg")) if (PLAY_OUT / "shots").exists() else []
    slug = subprocess.run(["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"],
                          cwd=REPO, capture_output=True, text=True).stdout.strip()
    if not slug:
        die("could not resolve the GitHub repository with `gh repo view`")

    urls, note = {}, None
    session = read_text(SESSION_FILE).strip()
    if files and args.dry_run:
        note = f"dry run: {len(files)} media file(s) would be attached"
    elif files and not session:
        note = (f"{len(files)} media file(s) NOT attached: no GitHub web session in {SESSION_FILE}. "
                f"They are in {PLAY_OUT}; drag them into the PR, or save the `user_session` cookie there and re-run.")
    elif files:
        repo_id = subprocess.run(["gh", "api", f"repos/{slug}", "-q", ".id"], cwd=REPO, capture_output=True, text=True).stdout.strip()
        try:
            for path in files:
                if path.stat().st_size > 10_000_000:
                    say(f"skipping {path.name}: over GitHub's 10 MB attachment limit")
                    continue
                urls[str(path.relative_to(PLAY_OUT))] = attach(path, slug, args.pr, repo_id, session)
            say(f"attached {len(urls)} media file(s) to the pull request")
        except (UploadError, KeyError) as err:
            note = f"media upload stopped after {len(urls)} file(s): {err}. The rest are in {PLAY_OUT}."

    report = read_text(build_report(urls))
    if note:
        say(note)
    if args.dry_run:
        say(f"dry run: report at {OUT / 'report.md'}; pull request not touched")
        return 0
    body = subprocess.run(["gh", "pr", "view", str(args.pr), "--json", "body", "-q", ".body"],
                          cwd=REPO, capture_output=True, text=True)
    if body.returncode:
        die(f"could not read pull request #{args.pr}: {body.stderr.strip()}")
    old = body.stdout.rstrip("\n")
    if START in old and END in old:
        new = old[: old.index(START)] + report.strip() + old[old.index(END) + len(END):]
    else:
        new = (old + "\n\n" if old else "") + report.strip()
    (OUT / "pr-body.md").write_text(new + "\n")
    done = subprocess.run(["gh", "pr", "edit", str(args.pr), "--body-file", str(OUT / "pr-body.md")], cwd=REPO)
    if done.returncode == 0:
        say(f"report written into the body of pull request #{args.pr}")
    return 1 if (done.returncode or note) else 0


def cmd_finalize(args):
    """Headless gate, then a recorded playtest, then (with --pr) the report on the pull request."""
    base = base_ref(args)
    code = cmd_headless(argparse.Namespace(map=args.map, timeout=180, only=None, compare=base, show=25))
    played = 0
    if args.skip_play:
        say("playtest skipped by --skip-play")
        rmtree(PLAY_OUT)
    elif not find_client():
        say("playtest NOT RUN: the Garry's Mod client is not installed (see `harness/gw doctor`)")
        rmtree(PLAY_OUT)
        played = 1
    else:
        cmd_play_start(argparse.Namespace(map=args.map, res="1280x720", fps=30, timeout=240, no_server=False, client_cmd=None))
        try:
            played = cmd_playtest(args)
        finally:
            cmd_play_stop(args)
    if args.pr:
        cmd_publish(argparse.Namespace(pr=args.pr, dry_run=args.dry_run))
    else:
        say(f"report: {build_report()}")
    return 1 if (code or played) else 0



