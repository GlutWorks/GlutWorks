class RpcError(Exception):
    pass


def rpc(realm, op, timeout=20, **fields):
    """Sends one request to the server ("sv") or client ("cl") Lua state and returns its result."""
    if not session_alive():
        raise RpcError("no play session is running; `harness/gw play start`")
    request_id = f"{int(time.time() * 1000)}{os.getpid()}"
    request = RPC[realm] / f"{realm}_req_{request_id}.json"
    response = RPC[realm] / f"{realm}_res_{request_id}.json"
    tmp = request.with_suffix(".tmp")
    tmp.write_text(json.dumps(dict(fields, id=request_id, op=op)))
    tmp.rename(request)

    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            payload = json.loads(response.read_text())
            response.unlink()
            if not payload.get("ok"):
                raise RpcError(payload.get("error", "request failed"))
            return payload.get("result")
        except (OSError, ValueError):
            time.sleep(0.05)
    request.unlink(missing_ok=True)
    raise RpcError(f"no reply from the {'server' if realm == 'sv' else 'client'} within {timeout}s")


def cmd_play_rpc(args):
    spec = {
        "sv": ("sv", "lua", {"code": " ".join(args.rest)}),
        "cl": ("cl", "lua", {"code": " ".join(args.rest)}),
        "con": ("cl", "con", {"command": " ".join(args.rest)}),
        "state": ("cl", "state", {}),
        "panels": ("cl", "panels", {}),
        "errors": (None, "errors", {}),
        "checks": ("sv", "checks", {}),
        "click": ("cl", "click", lambda r: {"x": int(r[0]), "y": int(r[1]), "button": r[2] if len(r) > 2 else "left"}),
        "press": ("cl", "press", lambda r: {"text": r[0], "button": r[1] if len(r) > 1 else "left"}),
        "key": ("cl", "key", lambda r: {"key": r[0], "seconds": float(r[1]) if len(r) > 1 else 0.1}),
        "look": ("cl", "look", lambda r: json.loads(r[0])),
        "move": ("cl", "move", lambda r: json.loads(r[0])),
    }[args.op]
    realm, op, fields = spec
    try:
        fields = fields(args.rest) if callable(fields) else fields
        if realm is None:
            result = {"server": rpc("sv", op), "client": rpc("cl", op) if find_client() else None}
        else:
            result = rpc(realm, op, timeout=40 if op == "move" else 20, **fields)
    except (RpcError, IndexError, ValueError) as err:
        die(str(err), 1)
    print(json.dumps(result, indent=1))
    return 0


