ATTACH_LIMIT = 9_500_000  # GitHub accepts attachments up to 10 MB on every plan


def media_seconds(path):
    out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(path)],
                         capture_output=True, text=True).stdout.strip()
    try:
        return float(out)
    except ValueError:
        return 0.0


def encode_media():
    """Turns the raw recording into an MP4 small enough to attach to a pull request.

    A session that does not fit at normal speed is sped up just enough to fit, and the
    speed is written to speed.txt so the report can say so.
    """
    raw, mp4 = PLAY_OUT / "session.mkv", PLAY_OUT / "session.mp4"
    if not raw.exists() or not raw.stat().st_size:
        say("no recording was produced")
        return None

    def encode(extra):
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(raw)] + extra +
                       ["-c:v", "libx264", "-preset", "medium", "-pix_fmt", "yuv420p", "-movflags", "+faststart",
                        "-an", str(mp4)], stderr=subprocess.DEVNULL, check=False)

    encode(["-vf", "fps=20", "-crf", "28"])
    duration = media_seconds(mp4)
    if not duration:
        mp4.unlink(missing_ok=True)
        say("no usable recording was produced (nothing was drawn on screen)")
        return None
    speed = 1.0
    if mp4.stat().st_size > ATTACH_LIMIT:
        bitrate = 450_000
        speed = max(1.0, duration / (ATTACH_LIMIT * 8 * 0.95 / bitrate))
        encode(["-vf", f"setpts=PTS/{speed:.3f},fps=20", "-b:v", str(bitrate), "-maxrate", str(int(bitrate * 1.1)),
                "-bufsize", str(bitrate * 2)])
    (PLAY_OUT / "speed.txt").write_text(f"{speed:.2f}")
    say(f"recording: {mp4} ({duration:.0f}s of play"
        + (f", sped up {speed:.1f}x to fit" if speed > 1 else "") + f", {mp4.stat().st_size // 1024} KiB)")
    return mp4


def inner_pid():
    """The session's own process group leader, a child of the bwrap we started: bwrap's
    --new-session puts the session in a process group of its own. None once it has exited."""
    try:
        pid = int(read_text(PLAY / "inner.pid"))
        stat = read_text(f"/proc/{pid}/stat")
        return pid if stat and int(stat.rsplit(")", 1)[1].split()[2]) == pid else None
    except (ValueError, IndexError):
        return None


def session_running():
    """Whether this checkout's session has a live process, as seen from the host. (From
    inside another sandbox, where its processes are invisible, see session_alive.)"""
    return bool(play_pid() or inner_pid())


def stop_relays():
    """Stops the relays this checkout's last session started, if they still run: a session
    that ended without `stop` leaves them holding their ports. A recorded pid is signalled
    only while its command line is still that relay's."""
    for name in ("relay.pid", "stream.pid"):
        try:
            pid = int(read_text(PLAY / name))
            argv = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
            if str(REPO / "harness/portproxy.py").encode() in argv and str(PLAY / "ipc").encode() in b" ".join(argv):
                os.kill(pid, signal.SIGTERM)
        except (ValueError, OSError):
            pass
        (PLAY / name).unlink(missing_ok=True)


def stop_session():
    """Stops the session and its relays and encodes the recording. The game-client lock goes
    with the session's last process. Returns the encoded video, or None."""
    group = inner_pid()  # only a group whose leader is alive now is ours to empty below
    if play_pid() or group or session_alive():
        (PLAY_OUT / "stop").write_text("stop")
        for _ in range(150):
            if not (play_pid() or inner_pid()):
                break
            time.sleep(0.1)
        for pid in (play_pid(), inner_pid()):
            if pid:
                os.killpg(pid, signal.SIGKILL)
    # What the session started can outlive its script (the game runs as a child of
    # hl2.sh) and holds the game-client lock until it exits, so the group is emptied.
    for sig in (signal.SIGTERM, signal.SIGKILL) if group else ():
        try:
            os.killpg(group, sig)
            for _ in range(50):
                os.killpg(group, 0)
                time.sleep(0.1)
        except ProcessLookupError:
            break
    (PLAY / "inner.pid").unlink(missing_ok=True)
    # The kernel drops the lock when the last of the session's processes has fully exited,
    # which a busy disk can delay by tens of seconds; the next session should not see it held.
    sid = json.loads(read_text(SESSION) or "{}").get("id")
    deadline = time.time() + 60
    while sid and (lock_holder() or {}).get("session") == sid:
        if time.time() > deadline:
            say("warning: the game-client lock is still held by this session's last processes")
            break
        time.sleep(0.2)
    stop_relays()
    (PLAY / "stream.json").unlink(missing_ok=True)
    for console in (PLAY / "client-upper/garrysmod/console.log", PLAY / "upper/garrysmod/console.log"):
        if console.exists():
            shutil.copy(console, PLAY_OUT / "console.log")
            (PLAY_OUT / "server-errors.json").write_text(json.dumps(scan_console(read_text(console)), indent=2))
            break
    video = encode_media()
    say("session stopped")
    return video


