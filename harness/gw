#!/usr/bin/env python3
"""GlutWorks test harness.

Every command works on the checkout this script lives in, inside a bubblewrap sandbox with
no network and its own copy-on-write view of the game install, so runs from different
worktrees never see each other. See harness/README.md.
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
HOME = Path(os.environ.get("GW_HARNESS_HOME", Path.home() / ".local/share/gw-harness"))
DS = HOME / "gmodds"
STEAMCMD = HOME / "steamcmd"
TOOLS = HOME / "tools"
ADDONS = HOME / "addons"
RUN_ID = f"{REPO.name}-{hashlib.sha1(str(REPO).encode()).hexdigest()[:8]}"
RUN = HOME / "runs" / RUN_ID
OUT = Path(os.environ.get("GW_OUT", REPO / ".gw"))

GAMEMODE = "ixhl2rp"
# Gamemode folders taken from the checkout. base/sandbox/terrortown in the repo are a 2022
# copy of the stock gamemodes; the server's own current copies are used unless GW_MOUNT=all.
MOUNT = ["helix", "ixhl2rp"]
STOCK = ["base", "sandbox", "terrortown"]

ERROR_LINE = re.compile(
    r"\[ERROR\]|Lua Error|Couldn't include file|error loading module|"
    r"Warning! A net message|Tried to use a NULL|\[gw_harness\]"
)


def say(msg):
    print(f"[gw] {msg}", flush=True)


def die(msg, code=2):
    print(f"[gw] error: {msg}", file=sys.stderr)
    sys.exit(code)


def read_text(path):
    try:
        return Path(path).read_text(errors="replace")
    except OSError:
        return ""


def rmtree(path):
    """Removes a tree, including the mode-000 work directory overlayfs leaves behind."""
    if Path(path).exists():
        subprocess.run(["chmod", "-R", "u+rwX", str(path)], check=False)
        shutil.rmtree(path)


# --------------------------------------------------------------------------- sandbox


def addons():
    """Workshop addons the gamemode needs, as (id, directory) pairs in manifest order.

    harness/addons.json is the manifest; `gw setup` downloads and unpacks each one. Only
    entries marked required are mounted, so a run sees the same content every time
    regardless of what the Steam account happens to be subscribed to.
    """
    if os.environ.get("GW_NO_ADDONS"):
        return []
    try:
        manifest = json.loads((REPO / "harness/addons.json").read_text())
    except (OSError, ValueError):
        return []
    return [(entry["id"], ADDONS / entry["id"]) for entry in manifest if entry.get("required")]


def sandbox(src, layer, data, play=None, net=False):
    """bwrap argv giving the process a private root with the server install at /gw/ds.

    The install is the read-only lower layer of an overlay whose upper layer is under
    `layer`; the gamemodes from `src` and the harness addon are bound on top read-only,
    and `data` (a host directory) becomes the server's data/gw_harness. `play` adds what a
    graphical session needs: the GPU, the tools prefix, an output directory and, when the
    game client is installed, a second overlay for it at /gw/client.
    """
    upper, work = layer / "upper", layer / "work"
    for path in (upper, work, data):
        path.mkdir(parents=True, exist_ok=True)

    argv = [
        "bwrap", "--new-session",
        "--unshare-user", "--unshare-uts", "--unshare-cgroup-try",
        "--ro-bind", "/usr", "/usr", "--ro-bind", "/etc", "/etc",
        "--symlink", "usr/lib", "/lib", "--symlink", "usr/lib", "/lib64",
        "--symlink", "usr/bin", "/bin", "--symlink", "usr/bin", "/sbin",
        "--proc", "/proc", "--dev", "/dev",
        "--tmpfs", "/tmp", "--tmpfs", "/run", "--tmpfs", "/var", "--tmpfs", "/home",
        "--overlay-src", str(DS), "--overlay", str(upper), str(work), "/gw/ds",
    ]
    if not net:
        argv.append("--unshare-net")
    if not play:
        argv.append("--die-with-parent")  # a play session outlives the command that started it

    folders = MOUNT + (STOCK if os.environ.get("GW_MOUNT") == "all" else [])
    for name in folders:
        if (src / name).is_dir():
            argv += ["--ro-bind", str(src / name), f"/gw/ds/garrysmod/gamemodes/{name}"]

    argv += ["--ro-bind", str(REPO / "harness/addon/gw_harness"), "/gw/ds/garrysmod/addons/gw_harness"]
    argv += ["--bind", str(data), "/gw/ds/garrysmod/data/gw_harness"]
    mounted = [(workshop_id, path) for workshop_id, path in addons() if path.is_dir()]
    for workshop_id, path in mounted:
        argv += ["--ro-bind", str(path), f"/gw/ds/garrysmod/addons/ws_{workshop_id}"]

    home = "/home/gw"
    if play:
        argv += ["--dev-bind", "/dev/dri", "/dev/dri", "--ro-bind", "/sys", "/sys",
                 "--ro-bind", str(TOOLS), "/gw/tools", "--bind", str(play["out"]), "/gw/out",
                 "--ro-bind", str(REPO / "harness/session.sh"), "/gw/session.sh",
                 "--ro-bind", str(REPO / "harness/portproxy.py"), "/gw/portproxy.py"]
        client = play.get("client")
        if client:
            # The play session is a listen server: the game client hosts the gamemode
            # itself, so the checkout and the harness addon are mounted into the client.
            cupper, cwork = layer / "client-upper", layer / "client-work"
            for path in (cupper, cwork):
                path.mkdir(parents=True, exist_ok=True)
            argv += ["--overlay-src", str(client), "--overlay", str(cupper), str(cwork), "/gw/client"]
            for name in folders:
                if (src / name).is_dir():
                    argv += ["--ro-bind", str(src / name), f"/gw/client/garrysmod/gamemodes/{name}"]
            argv += ["--ro-bind", str(REPO / "harness/addon/gw_harness"), "/gw/client/garrysmod/addons/gw_harness",
                     "--bind", str(data), "/gw/client/garrysmod/data/gw_harness"]
            for workshop_id, path in mounted:
                argv += ["--ro-bind", str(path), f"/gw/client/garrysmod/addons/ws_{workshop_id}"]
            # The client must reach the Steam client running in the host session to pass
            # its ownership check, so it keeps the host's process and IPC namespaces and
            # sees the Steam directories read-only at their real paths. Steam's local IPC
            # port is relayed in through /gw/ipc; see portproxy.py.
            home = str(Path.home())
            argv += ["--dir", home, "--bind", "/dev/shm", "/dev/shm", "--bind", str(play["ipc"]), "/gw/ipc"]
            if compat_dir(play["client"]).is_dir():
                argv += ["--ro-bind", str(compat_dir(play["client"])), "/gw/compat"]
            for path in (Path.home() / ".steam", Path.home() / ".local/share/Steam"):
                if path.exists():
                    argv += ["--ro-bind", str(path), str(path)]
    if not (play and play.get("client")):
        argv += ["--unshare-pid", "--unshare-ipc", "--dir", home]

    argv += ["--setenv", "HOME", home, "--chdir", "/gw/ds"]
    return argv


def server_argv(map_name, port=27015):
    return [
        "env", "LD_LIBRARY_PATH=.:bin/linux64:linux64", "./bin/linux64/srcds", "-game", "garrysmod", "-console", "-norestart", "-nomaster",
        "-nohltv", "-disableluarefresh", "-condebug", "-ip", "127.0.0.1", "-port", str(port), "-maxplayers", "8",
        "+sv_lan", "1", "+sv_hibernate_think", "1", "+gamemode", GAMEMODE, "+map", map_name,
    ]


# --------------------------------------------------------------------------- headless


def scan_console(text):
    """Returns error blocks from a server console log: the matching line plus its stack."""
    lines = text.splitlines()
    blocks, i = [], 0
    while i < len(lines):
        if ERROR_LINE.search(lines[i]):
            block = [lines[i].rstrip()]
            i += 1
            while i < len(lines) and re.match(r"^\s+\d+\. ", lines[i]):
                block.append(lines[i].rstrip())
                i += 1
            blocks.append("\n".join(block))
        else:
            i += 1
    return blocks


def run_headless(src, name, map_name, timeout, only=None):
    """Boots the server on `src` in the sandbox, runs the checks, returns the result dict."""
    layer = RUN / name
    rmtree(layer)
    data = layer / "data"
    data.mkdir(parents=True)
    (data / "config.json").write_text(json.dumps({
        "mode": "smoke", "quit": True, "gamemode": GAMEMODE, "roots": MOUNT, "only": only,
    }))

    stdout = layer / "stdout.log"
    started = time.time()
    with open(stdout, "wb") as log:
        proc = subprocess.Popen(
            sandbox(src, layer, data) + server_argv(map_name),
            stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT, start_new_session=True,
        )
        result_file = data / "result.json"
        timed_out = False
        while proc.poll() is None:
            if time.time() - started > timeout:
                timed_out = True
                break
            if '"done":true' in read_text(result_file).replace(" ", ""):
                try:
                    proc.wait(8)
                except subprocess.TimeoutExpired:
                    pass
                break
            time.sleep(0.5)
        if proc.poll() is None:
            os.killpg(proc.pid, signal.SIGTERM)
            try:
                proc.wait(10)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)

    console = layer / "upper/garrysmod/console.log"
    text = console.read_text(errors="replace") if console.exists() else stdout.read_text(errors="replace")
    try:
        result = json.loads(result_file.read_text())
    except (OSError, ValueError):
        result = {}

    result.update({
        "timed_out": timed_out,
        "seconds": round(time.time() - started, 1),
        "console_errors": scan_console(text),
        "console": text,
    })
    return result


def failures_of(result):
    """Flat, comparable set of failure strings for a headless result."""
    found = set()
    if not result.get("done"):
        found.add("server: did not finish the check run" + (" (timeout)" if result.get("timed_out") else ""))
    for check in result.get("checks", []):
        for failure in check.get("failures", []):
            found.add(f"{check['name']}: {failure}")
    for err in result.get("errors", []):
        found.add("lua error: " + err["error"])
    for block in result.get("console_errors", []):
        found.add("console: " + block.splitlines()[0].strip())
    return found


def write_headless(result, dest, label):
    dest.mkdir(parents=True, exist_ok=True)
    (dest / "console.log").write_text(result.pop("console", ""))
    (dest / "result.json").write_text(json.dumps(result, indent=2))
    lines = [f"### Headless run: {label}", "", f"Finished: {bool(result.get('done'))} in {result['seconds']}s", ""]
    if result.get("checks"):
        lines += ["| Check | Result | Detail |", "|---|---|---|"]
        for check in result["checks"]:
            detail = json.dumps(check.get("detail")) if check.get("detail") else ""
            status = "pass" if check["ok"] else f"**{len(check['failures'])} failed**"
            lines.append(f"| {check['name']} | {status} | `{detail}` |" if detail else f"| {check['name']} | {status} | |")
    (dest / "summary.md").write_text("\n".join(lines) + "\n")


def cmd_headless(args):
    need_install()
    say(f"headless boot of {REPO} (run {RUN_ID}, no network)")
    result = run_headless(REPO, "headless", args.map, args.timeout, args.only)
    mine = failures_of(result)
    write_headless(result, OUT / "headless", "this checkout")

    base = None
    if args.compare:
        base_src = RUN / "base-src"
        rmtree(base_src)
        base_src.mkdir(parents=True)
        ref = subprocess.run(["git", "-C", str(REPO), "merge-base", "HEAD", args.compare],
                             capture_output=True, text=True).stdout.strip() or args.compare
        say(f"headless boot of base {ref[:10]} for comparison")
        archive = subprocess.Popen(["git", "-C", str(REPO), "archive", ref] + MOUNT, stdout=subprocess.PIPE)
        subprocess.run(["tar", "-x", "-C", str(base_src)], stdin=archive.stdout, check=True)
        base_result = run_headless(base_src, "headless-base", args.map, args.timeout, args.only)
        base = failures_of(base_result)
        write_headless(base_result, OUT / "headless-base", f"base {ref[:10]}")

    new = sorted(mine - base) if base is not None else sorted(mine)
    fixed = sorted(base - mine) if base is not None else []
    known = sorted(mine & base) if base is not None else []
    verdict = {"pass": not new, "new": new, "fixed": fixed, "known": known}
    (OUT / "headless/verdict.json").write_text(json.dumps(verdict, indent=2))

    for check in result.get("checks", []):
        say(f"  {'ok  ' if check['ok'] else 'FAIL'} {check['name']}"
            + (f"  ({len(check['failures'])} failures)" if not check["ok"] else ""))
    if base is not None:
        say(f"{len(new)} new, {len(fixed)} fixed, {len(known)} already failing on base")
    for line in new[: args.show]:
        say(f"  new: {line}")
    if len(new) > args.show:
        say(f"  ... {len(new) - args.show} more in {OUT / 'headless/verdict.json'}")
    say(f"artifacts: {OUT / 'headless'}")
    say("PASS" if verdict["pass"] else "FAIL")
    return 0 if verdict["pass"] else 1


# --------------------------------------------------------------------------- play session

PLAY = RUN / "play"
PLAY_OUT = OUT / "play"
RPC = {"sv": PLAY_OUT / "rpc", "cl": PLAY_OUT / "rpc"}
STEAM_IPC_PORT = 57343  # where the Steam client listens for games on this machine
PORT = 27100 + int(hashlib.sha1(str(REPO).encode()).hexdigest(), 16) % 800


def find_client():
    """The installed Garry's Mod client, or None. GW_CLIENT_DIR overrides the search."""
    override = os.environ.get("GW_CLIENT_DIR")
    roots = [Path(override)] if override else []
    steam = Path.home() / ".local/share/Steam"
    libraries = re.findall(r'"path"\s+"([^"]+)"', read_text(steam / "steamapps/libraryfolders.vdf"))
    roots += [Path(lib) / "steamapps/common/GarrysMod" for lib in [str(steam)] + libraries]
    for root in roots:
        if (root / "garrysmod/gameinfo.txt").exists():
            return root
    return None


def play_pid():
    try:
        pid = int(read_text(PLAY / "pid"))
        os.kill(pid, 0)
        return pid
    except (ValueError, OSError):
        return None


def session_alive():
    """True while the session loop is beating. Works from inside another sandbox, where
    the session's process cannot be seen or signalled."""
    try:
        return time.time() - (PLAY_OUT / "alive").stat().st_mtime < 5 and not (PLAY_OUT / "stop").exists()
    except OSError:
        return False


def phase():
    return read_text(PLAY_OUT / "phase").strip()


def cmd_play_start(args):
    need_install()
    if not (TOOLS / "usr/bin/sway").exists():
        die("session tools missing; run `harness/gw setup`")
    if play_pid():
        die("a play session for this checkout is already running; `harness/gw play stop` first")

    client = find_client()
    if args.client_cmd:
        client_cmd, client = args.client_cmd, None
    elif client:
        width, height = args.res.split("x")
        client_cmd = (f"cd /gw/client && SteamAppId=4000 SteamGameId=4000 LD_LIBRARY_PATH=/gw/compat exec ./hl2.sh "
                      f"-steam -game garrysmod -windowed -noborder -w {width} -h {height} -novid -console -condebug "
                      f"-nojoy -noworkshop +sv_lan 1 +maxplayers 8 +gamemode {GAMEMODE} +map {args.map}")
    else:
        die("Garry's Mod client not found in any Steam library (install app 4000, or set GW_CLIENT_DIR). "
            "The headless stage does not need it.")

    rmtree(PLAY)
    rmtree(PLAY_OUT)
    for path in (PLAY, PLAY_OUT, RPC["sv"]):
        path.mkdir(parents=True)
    (RPC["sv"] / "config.json").write_text(json.dumps({"mode": "play", "gamemode": GAMEMODE, "roots": MOUNT}))

    env = dict(os.environ, GW_RES=args.res, GW_FPS=str(args.fps), GW_CLIENT=client_cmd)
    ipc = PLAY / "ipc"
    ipc.mkdir()
    if client:
        # Relay the Steam client's local IPC port into the sandbox; see portproxy.py.
        relay = subprocess.Popen([sys.executable, str(REPO / "harness/portproxy.py"), "host", str(ipc / "steam.sock"),
                                  str(STEAM_IPC_PORT)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
        (PLAY / "relay.pid").write_text(str(relay.pid))
        env["GW_STEAM_PORT"] = str(STEAM_IPC_PORT)
    if not client and not args.no_server:
        # Without the game client (a stand-in command) a dedicated server is started so
        # the server command channel can still be used.
        env["GW_SERVER"] = " ".join(server_argv(args.map, PORT)[2:])
    argv = sandbox(REPO, PLAY, RPC["sv"], net=os.environ.get("GW_PLAY_NET") == "host",
                   play={"out": PLAY_OUT, "client": client, "ipc": ipc})
    with open(PLAY_OUT / "session.log", "wb") as log:
        proc = subprocess.Popen(argv + ["/gw/session.sh"], env=env, stdin=subprocess.DEVNULL,
                                stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    (PLAY / "pid").write_text(str(proc.pid))
    say(f"play session starting (pid {proc.pid}, port {PORT}, {args.res}); logs in {PLAY_OUT}")

    deadline = time.time() + args.timeout
    while time.time() < deadline:
        if proc.poll() is not None or phase().startswith("failed"):
            die(f"session ended during startup ({phase() or 'no phase'}); see {PLAY_OUT / 'session.log'}", 1)
        if phase() == "running":
            break
        time.sleep(0.3)
    else:
        die("session did not reach the running phase in time", 1)

    if client:
        say("waiting for the game to load the map")
        while time.time() < deadline:
            try:
                if rpc("cl", "state", timeout=5).get("connected"):
                    break
            except RpcError:
                pass
            if proc.poll() is not None:
                die(f"the game exited while loading; see {PLAY_OUT / 'client.log'}", 1)
        else:
            die(f"the game did not finish loading within {args.timeout}s; see {PLAY_OUT / 'client.log'}", 1)
    say("session running")
    return 0


ATTACH_LIMIT = 9_500_000  # GitHub accepts attachments up to 10 MB on every plan


def encode_media():
    """Turns the raw recording into an MP4 small enough to attach to a pull request.

    A session that does not fit at normal speed is sped up just enough to fit, and the
    speed is written to speed.txt so the report can say so.
    """
    raw, mp4 = PLAY_OUT / "session.mkv", PLAY_OUT / "session.mp4"
    if not raw.exists() or not raw.stat().st_size:
        say("no recording was produced")
        return

    def encode(extra):
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(raw)] + extra +
                       ["-c:v", "libx264", "-preset", "medium", "-pix_fmt", "yuv420p", "-movflags", "+faststart",
                        "-an", str(mp4)], stderr=subprocess.DEVNULL, check=False)

    def duration_of(path):
        out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(path)],
                             capture_output=True, text=True).stdout.strip()
        try:
            return float(out)
        except ValueError:
            return 0.0

    encode(["-vf", "fps=20", "-crf", "28"])
    duration = duration_of(mp4)
    if not duration:
        mp4.unlink(missing_ok=True)
        say("no usable recording was produced (nothing was drawn on screen)")
        return
    speed = 1.0
    if mp4.stat().st_size > ATTACH_LIMIT:
        bitrate = 450_000
        speed = max(1.0, duration / (ATTACH_LIMIT * 8 * 0.95 / bitrate))
        encode(["-vf", f"setpts=PTS/{speed:.3f},fps=20", "-b:v", str(bitrate), "-maxrate", str(int(bitrate * 1.1)),
                "-bufsize", str(bitrate * 2)])
    (PLAY_OUT / "speed.txt").write_text(f"{speed:.2f}")
    say(f"recording: {mp4} ({duration:.0f}s of play"
        + (f", sped up {speed:.1f}x to fit" if speed > 1 else "") + f", {mp4.stat().st_size // 1024} KiB)")


def cmd_play_stop(_args):
    pid = play_pid()
    if pid:
        (PLAY_OUT / "stop").write_text("stop")
        for _ in range(150):
            if not play_pid():
                break
            time.sleep(0.1)
        if play_pid():
            os.killpg(pid, signal.SIGKILL)
    try:
        os.kill(int(read_text(PLAY / "relay.pid")), signal.SIGTERM)
    except (ValueError, OSError):
        pass
    for console in (PLAY / "client-upper/garrysmod/console.log", PLAY / "upper/garrysmod/console.log"):
        if console.exists():
            shutil.copy(console, PLAY_OUT / "console.log")
            (PLAY_OUT / "server-errors.json").write_text(json.dumps(scan_console(read_text(console)), indent=2))
            break
    encode_media()
    say("session stopped")
    return 0


def cmd_play_status(_args):
    say(f"{'running' if session_alive() else 'not running'}; phase: {phase() or 'none'}; port {PORT}")
    return 0 if session_alive() else 1


class RpcError(Exception):
    pass


def rpc(realm, op, timeout=20, **fields):
    """Sends one request to the server ("sv") or client ("cl") Lua state and returns its result."""
    if not session_alive():
        raise RpcError("no play session is running; `harness/gw play start`")
    request_id = f"{int(time.time() * 1000)}{os.getpid()}"
    request = RPC[realm] / f"{realm}_req_{request_id}.json"
    response = RPC[realm] / f"{realm}_res_{request_id}.json"
    tmp = request.with_suffix(".tmp")
    tmp.write_text(json.dumps(dict(fields, id=request_id, op=op)))
    tmp.rename(request)

    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            payload = json.loads(response.read_text())
            response.unlink()
            if not payload.get("ok"):
                raise RpcError(payload.get("error", "request failed"))
            return payload.get("result")
        except (OSError, ValueError):
            time.sleep(0.05)
    request.unlink(missing_ok=True)
    raise RpcError(f"no reply from the {'server' if realm == 'sv' else 'client'} within {timeout}s")


def cmd_play_rpc(args):
    spec = {
        "sv": ("sv", "lua", {"code": " ".join(args.rest)}),
        "cl": ("cl", "lua", {"code": " ".join(args.rest)}),
        "con": ("cl", "con", {"command": " ".join(args.rest)}),
        "state": ("cl", "state", {}),
        "panels": ("cl", "panels", {}),
        "errors": (None, "errors", {}),
        "checks": ("sv", "checks", {}),
        "click": ("cl", "click", lambda r: {"x": int(r[0]), "y": int(r[1]), "button": r[2] if len(r) > 2 else "left"}),
        "press": ("cl", "press", lambda r: {"text": r[0], "button": r[1] if len(r) > 1 else "left"}),
        "key": ("cl", "key", lambda r: {"key": r[0], "seconds": float(r[1]) if len(r) > 1 else 0.1}),
        "look": ("cl", "look", lambda r: json.loads(r[0])),
        "move": ("cl", "move", lambda r: json.loads(r[0])),
    }[args.op]
    realm, op, fields = spec
    try:
        fields = fields(args.rest) if callable(fields) else fields
        if realm is None:
            result = {"server": rpc("sv", op), "client": rpc("cl", op) if find_client() else None}
        else:
            result = rpc(realm, op, timeout=40 if op == "move" else 20, **fields)
    except (RpcError, IndexError, ValueError) as err:
        die(str(err), 1)
    print(json.dumps(result, indent=1))
    return 0


def xdo(*argv):
    """Runs xdotool inside the session with these arguments and returns its output."""
    if not session_alive():
        die("no play session is running", 1)
    (PLAY_OUT / "xdo.out").unlink(missing_ok=True)
    tmp = PLAY_OUT / "xdo.req.tmp"
    tmp.write_bytes(b"".join(arg.encode() + b"\0" for arg in argv))
    tmp.rename(PLAY_OUT / "xdo.req")
    for _ in range(300):
        if (PLAY_OUT / "xdo.out").exists():
            return read_text(PLAY_OUT / "xdo.out")
        time.sleep(0.1)
    die("xdotool did not answer", 1)


def cmd_play_xdo(args):
    """Sends real keyboard or mouse input to the session through xdotool."""
    print(xdo(*args.rest), end="")
    return 0


def cmd_play_type(args):
    """Types into the focused field with real key events, which is what Derma text entries react to."""
    if args.replace:
        xdo("key", "ctrl+a", "key", "BackSpace")
    xdo("type", "--delay", "12", args.text)
    if args.enter:
        xdo("key", "Return")
    print(json.dumps({"typed": args.text}))
    return 0


def cmd_play_shot(args):
    if not session_alive():
        die("no play session is running", 1)
    shots = PLAY_OUT / "shots"
    shots.mkdir(exist_ok=True)
    name = f"{len(list(shots.glob('*.jpg'))) + 1:02d}_{re.sub(r'[^A-Za-z0-9_-]', '_', args.name)}"
    (PLAY_OUT / "shot.req").write_text(name)
    for _ in range(100):
        if (shots / f"{name}.jpg").exists() and not (PLAY_OUT / "shot.req").exists():
            time.sleep(0.1)
            print(shots / f"{name}.jpg")
            return 0
        time.sleep(0.1)
    die("screenshot was not produced; see recorder.log", 1)



