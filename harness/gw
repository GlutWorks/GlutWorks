def take_shot(name):
    """Has the session save a screenshot as shots/<name>.jpg; returns its path, or None.

    Each request is its own file, so callers in other processes never overwrite each other's.
    """
    shots = PLAY_OUT / "shots"
    shots.mkdir(exist_ok=True)
    tmp = shots / f".{name}.tmp"
    tmp.write_text("")
    tmp.rename(shots / f"{name}.req")
    for _ in range(100):
        if (shots / f"{name}.jpg").exists():
            return shots / f"{name}.jpg"
        if (shots / f"{name}.err").exists():
            return None
        time.sleep(0.05)
    (shots / f"{name}.req").unlink(missing_ok=True)
    return None


